---
/**
 * PromoSpotlight — a short, eye-catching promo section redirecting to a retail
 * product page. Distinct from ProductPromo (a quiet link band further down
 * the page): this one is meant to be seen early, right after the Hero, and
 * carries real visual weight — Morado ground + a real CTA button — while
 * staying brief (client request: "llamativa pero breve", placed as the
 * landing's 2nd section).
 *
 * Contract:
 *   photo      { src: string | null, alt: string }  required — placeholder-safe
 *   eyebrow    string   required
 *   title      string   required
 *   microcopy  string   required
 *   href       string   required — internal route to the product page
 *   linkLabel  string   required
 */
interface Props {
  photo: {
    src: string | null;
    alt: string;
    srcsetWebp?: string;
    srcsetAvif?: string;
  };
  eyebrow: string;
  title: string;
  microcopy: string;
  href: string;
  linkLabel: string;
}

const { photo, eyebrow, title, microcopy, href, linkLabel } = Astro.props;
---

<section class="promo-spotlight" aria-labelledby="promo-spotlight-heading">
  <div class="promo-spotlight__inner">
    <div class="promo-spotlight__photo" aria-hidden={!photo.src}>
      {
        photo.src ? (
          <picture>
            {photo.srcsetAvif && <source type="image/avif" srcset={photo.srcsetAvif} sizes="(min-width: 1024px) 380px, (min-width: 640px) 260px, 280px" />}
            {photo.srcsetWebp && <source type="image/webp" srcset={photo.srcsetWebp} sizes="(min-width: 1024px) 380px, (min-width: 640px) 260px, 280px" />}
            <img src={photo.src} alt={photo.alt} />
          </picture>
        ) : (
          <span>{photo.alt}</span>
        )
      }
    </div>
    <div class="promo-spotlight__copy">
      <p class="promo-spotlight__eyebrow">{eyebrow}</p>
      <h2 class="promo-spotlight__title" id="promo-spotlight-heading">{title}</h2>
      <p class="promo-spotlight__microcopy">{microcopy}</p>
      <a class="promo-spotlight__cta" href={href}>{linkLabel} →</a>
    </div>
  </div>
</section>

<style>
  /* Morado ground — same weight as FinalCta so this reads as a real promotion,
     not a footnote, while staying a single short band (not a full section). */
  .promo-spotlight {
    background-color: var(--color-primary);
    color: var(--text-on-primary);
    padding-block: var(--space-lg);
    padding-inline: var(--space-md);
  }

  .promo-spotlight__inner {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    text-align: center;
  }

  .promo-spotlight__photo {
    width: 100%;
    max-width: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-surface-soft);
    font-size: var(--font-size-label);
    text-align: center;
  }

  .promo-spotlight__photo picture,
  .promo-spotlight__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* No uppercase/letter-spacing here — matches Hero/SectionHeader's eyebrow
     treatment across the site (design system donts: no "uppercase tracked
     eyebrows", that's the generic-SaaS pattern this system explicitly rejects). */
  .promo-spotlight__eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--color-surface-soft);
    font-weight: var(--font-weight-title);
    font-size: var(--font-size-label);
  }

  .promo-spotlight__title {
    margin: 0;
    color: var(--text-on-primary);
    font-weight: var(--font-weight-heading);
    font-size: var(--font-size-headline);
    line-height: 1.2;
  }

  .promo-spotlight__microcopy {
    margin: var(--space-xs) 0 0;
    max-width: 44ch;
    color: var(--color-surface-soft);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .promo-spotlight__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-surface);
    color: var(--color-primary);
    font-weight: var(--font-weight-title);
    font-size: var(--font-size-label);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .promo-spotlight__cta:hover,
  .promo-spotlight__cta:focus-visible {
    background-color: var(--color-surface-soft);
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .promo-spotlight__inner {
      max-width: 820px;
      flex-direction: row;
      text-align: left;
      gap: var(--space-lg);
    }

    /* 260px, not the old 220px — that was smaller than mobile's own 280px
       max-width, so the image visibly shrank right when it should have
       started growing. */
    .promo-spotlight__photo {
      flex: none;
      width: 260px;
    }

    .promo-spotlight__copy {
      flex: 1;
    }
  }

  /* Desktop: this band should carry real presence right after the Hero
     (client request: "llamativa"), not sit at the same modest size as on a
     phone. Mobile above is untouched. */
  @media (min-width: 1024px) {
    .promo-spotlight {
      padding-block: var(--space-xl);
    }

    .promo-spotlight__inner {
      max-width: 1040px;
      gap: var(--space-xl);
    }

    .promo-spotlight__photo {
      width: 380px;
    }

    .promo-spotlight__microcopy {
      font-size: 1.1875rem;
    }
  }
</style>
