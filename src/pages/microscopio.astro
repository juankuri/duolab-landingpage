    display: inline-flex;
    align-items: center;
  }

  .mv-band__phone:hover { text-decoration: underline; }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .mv-nav { padding: 24px 48px; }
    .mv-nav__links { display: flex; }
    .mv-nav__mobile { display: none; }

    .mv-copy {
      padding: 48px 48px 16px;
      font-size: inherit;
    }

    .mv-copy__title { font-size: 3.25rem; }
    .mv-copy__lead { font-size: 1.125rem; }

    .mv-caption { padding: 16px 48px; }

    .mv-thumbs {
      padding: 6px 48px 24px;
    }

    .mv-thumbs li {
      flex: 1 1 0;
      width: auto;
    }

    .mv-wrap { padding-inline: 48px; }

    .mv-sec { padding-block: 96px; }

    .mv-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 48px;
    }

    .mv-prod {
      aspect-ratio: auto;
      height: 100%;
      min-height: 440px;
    }

    .mv-band {
      grid-template-columns: 1fr auto;
      gap: 48px;
      align-items: center;
    }
  }
</style>

<script>
  // Slideshow — crossfade on prev/next/thumb/keyboard
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>("[data-slide]"));
    const thumbs = Array.from(stage.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
    const counterEl = stage.querySelector<HTMLElement>("[data-counter]");
    const captionNameEl = stage.querySelector<HTMLElement>("[data-caption-name]");
    const total = slides.length;
    const captions = thumbs.map((t) => t.getAttribute("aria-label") ?? "");

    let current = 0;

    const go = (n: number) => {
      current = ((n % total) + total) % total;

      slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
      thumbs.forEach((t, i) => {
        t.classList.toggle("is-active", i === current);
        t.setAttribute("aria-selected", i === current ? "true" : "false");
      });

      if (counterEl) counterEl.textContent = `Muestra ${current + 1} / ${total} · tomada con el microscopio`;
      if (captionNameEl) captionNameEl.textContent = captions[current] ?? "";
    };

    let timer: ReturnType<typeof setInterval> | null = null;
    const startAuto = () => { if (timer) return; timer = setInterval(() => go(current + 1), 3300); };
    const stopAuto  = () => { if (timer) { clearInterval(timer); timer = null; } };

    stage.addEventListener("mouseenter", stopAuto);
    stage.addEventListener("mouseleave", startAuto);
    stage.addEventListener("focusin", stopAuto);
    stage.addEventListener("focusout", startAuto);
    startAuto();

    stage.querySelector("[data-prev]")?.addEventListener("click", () => { stopAuto(); go(current - 1); startAuto(); });
    stage.querySelector("[data-next]")?.addEventListener("click", () => { stopAuto(); go(current + 1); startAuto(); });
    thumbs.forEach((t, i) => t.addEventListener("click", () => { stopAuto(); go(i); startAuto(); }));

    stage.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") { e.preventDefault(); stopAuto(); go(current + 1); startAuto(); }
      if (e.key === "ArrowLeft")  { e.preventDefault(); stopAuto(); go(current - 1); startAuto(); }
    });
  }

  // Mobile burger
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");

  burger?.addEventListener("click", () => {
    const open = drawer?.classList.toggle("is-open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    burger.querySelector("span")!.textContent = open ? "✕" : "☰";
    drawer?.setAttribute("aria-hidden", open ? "false" : "true");
  });

  document.querySelectorAll("[data-close-drawer]").forEach((link) => {
    link.addEventListener("click", () => {
      drawer?.classList.remove("is-open");
      burger?.setAttribute("aria-expanded", "false");
      if (burger) burger.querySelector("span")!.textContent = "☰";
      drawer?.setAttribute("aria-hidden", "true");
    });
  });

  // Product carousel — sliding track with arrow buttons + pill dots
  const miniCarousel = document.querySelector<HTMLElement>("[data-mini-carousel]");
  if (miniCarousel) {
    const track = miniCarousel.querySelector<HTMLElement>("[data-mini-track]")!;
    const dots  = miniCarousel.querySelectorAll<HTMLButtonElement>("[data-mini-dot]");
    const total = dots.length;
    let current = 0;

    const prevBtn = miniCarousel.querySelector<HTMLButtonElement>("[data-mini-prev]");
    const nextBtn = miniCarousel.querySelector<HTMLButtonElement>("[data-mini-next]");

    const goTo = (index: number, animate = true) => {
      current = Math.max(0, Math.min(index, total - 1));
      track.style.transition = animate ? "transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94)" : "none";
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === current);
        d.setAttribute("aria-selected", String(i === current));
      });
      if (prevBtn) prevBtn.style.display = current === 0 ? "none" : "flex";
      if (nextBtn) nextBtn.style.display = current === total - 1 ? "none" : "flex";
    };

    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));

    // Touch + mouse drag
    const viewport = miniCarousel.querySelector<HTMLElement>(".mv-prod") ?? miniCarousel;
    let startX = 0, dragging = false;

    const dragStart = (x: number) => { startX = x; dragging = true; };
    const dragMove  = (x: number) => {
      if (!dragging) return;
      const dx = x - startX;
      track.style.transition = "none";
      track.style.transform = `translateX(calc(-${current * 100}% + ${dx}px))`;
    };
    const dragEnd = (x: number) => {
      if (!dragging) return;
      dragging = false;
      const dx = x - startX;
      if (dx < -50)     goTo(current + 1);
      else if (dx > 50) goTo(current - 1);
      else              goTo(current);
    };

    viewport.addEventListener("touchstart", (e) => dragStart((e as TouchEvent).touches[0].clientX), { passive: true });
    viewport.addEventListener("touchmove",  (e) => dragMove((e as TouchEvent).touches[0].clientX),  { passive: true });
    viewport.addEventListener("touchend",   (e) => dragEnd((e as TouchEvent).changedTouches[0].clientX), { passive: true });
    viewport.addEventListener("mousedown",  (e) => { e.preventDefault(); dragStart(e.clientX); });
    window.addEventListener("mousemove",    (e) => dragMove(e.clientX));
    window.addEventListener("mouseup",      (e) => dragEnd(e.clientX));
  }
</script>
