{
  "name": "@duolab/backend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:setup": "wrangler d1 migrations apply duolab --local",
    "dev:seed": "node scripts/seed.mjs",
    "migrate:staging": "wrangler d1 migrations apply duolab-staging --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply duolab --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.10.6",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.26.0"
  }
}
