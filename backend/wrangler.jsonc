{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duolab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  // The same Worker serves the built frontend and the API, so everything is
  // one origin. That is what makes the CORS policy in src/index.ts correct:
  // it deliberately sends no CORS headers outside local dev, because in
  // production there is no cross-origin call to allow. Splitting these onto
  // two hostnames later would mean reopening that policy first.
  //
  // "none" is load-bearing: it means a request matching no static asset falls
  // through to the Worker. Any other value would answer /records, /files and
  // /api/public/* with the 404 page instead of running the API at all.
  //
  // Nothing in frontend/dist may ever occupy /records, /files, /me, /search,
  // /patients, /health or /api/* — assets win, and a public page at one of
  // those paths would silently shadow the endpoint behind it.
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duolab",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESULTS_BUCKET", // creates c.env.RESULTS_BUCKET.
      "bucket_name": "duolab-results" // actual R2 bucket name in Cloudflare.
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "duolab-team.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUDIENCE": "my-access-aud"
  }
}
