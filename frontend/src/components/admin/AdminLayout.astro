---
/**
 * Shell for every internal admin screen.
 *
 * Deliberately NOT layouts/Layout.astro: that one is landing-specific (requires
 * seo/business props and emits canonical, Open Graph and MedicalBusiness JSON-LD).
 * An internal tool needs none of it and must not be indexed.
 *
 * Everything static lives here; everything data-driven is built at runtime from
 * scripts/admin/render.js. Splitting on "is it known at build time" rather than
 * on "is it a component" keeps one implementation of each shape — a patient card
 * rendered by Astro on one screen and by JS on another would be two.
 */
interface Props {
  /** Browser tab title, without the brand suffix. */
  title: string;
  /** Shows the unified search box in the top bar. Off on screens that are themselves a search. */
  search?: boolean;
  /** Prefills the search box, so a result screen still shows what was asked. */
  query?: string;
}

const { title, search = true, query = "" } = Astro.props;

import "../../styles/clients/duolab.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · DúoLab</title>
  </head>
  <body>
    <header class="topbar">
      <a class="topbar__brand" href="/admin">
        <img src="/logo/logo-mark.svg" alt="" width="26" height="26" />
        <span class="topbar__name">dúolab</span>
      </a>

      {
        /*
         * One box, three criteria: folio, patient name, phone — GET /search
         * matches on all three. Present on every /admin/* screen except the
         * two where it would be redundant: /admin/buscar IS the search, and
         * /admin/revisar is a focused, single-result context.
         */
        search && (
          <form class="topbar__search" action="/admin/buscar" method="get" role="search">
            <label class="vh" for="f">
              Buscar folio, nombre o teléfono
            </label>
            <span class="search__icon" aria-hidden="true">
              ⌕
            </span>
            <input
              id="f"
              name="q"
              type="search"
              value={query}
              autocomplete="off"
              placeholder="Folio · nombre · teléfono…"
            />
          </form>
        )
      }

      <!-- Filled from GET /me. Server-side role enforcement is the real gate;
           this only decides what is worth offering. -->
      <p class="topbar__who"><span id="who-name">…</span><span class="avatar" id="who-initials"></span></p>
    </header>

    <main class="screen">
      <slot />
    </main>

    <script>
      /**
       * "/" focuses the search box from anywhere on the page, unless the
       * employee is already typing in a field — a bare "/" landing in a
       * folio or a patient's name would be actively wrong, not just unhelpful.
       */
      document.addEventListener("keydown", (event) => {
        if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;

        const target = event.target as HTMLElement | null;
        const typing =
          target &&
          (target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.isContentEditable);

        if (typing) return;

        const search = document.getElementById("f") as HTMLInputElement | null;
        if (!search) return;

        event.preventDefault();
        search.focus();
        search.select();
      });
    </script>
  </body>
</html>
