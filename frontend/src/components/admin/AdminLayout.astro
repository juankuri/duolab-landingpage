---
/**
 * Shell for every internal admin screen.
 *
 * Deliberately NOT layouts/Layout.astro: that one is landing-specific (requires
 * seo/business props and emits canonical, Open Graph and MedicalBusiness JSON-LD).
 * An internal tool needs none of it and must not be indexed.
 *
 * Everything static lives here; everything data-driven is built at runtime from
 * scripts/admin/render.js. Splitting on "is it known at build time" rather than
 * on "is it a component" keeps one implementation of each shape — a patient card
 * rendered by Astro on one screen and by JS on another would be two.
 */
interface Props {
  /** Browser tab title, without the brand suffix. */
  title: string;
}

const { title } = Astro.props;

import "../../styles/clients/duolab.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · DúoLab</title>
  </head>
  <body>
    <header class="topbar">
      <a class="topbar__brand" href="/admin">
        <img src="/logo/logo-mark.svg" alt="" width="26" height="26" />
        <span class="topbar__name">dúolab</span>
      </a>

      <!--
        No search box here on purpose. Searching happens in exactly two
        places — the home screen's own centred box and /admin/buscar — and a
        third copy in the bar was a prototype leftover that duplicated the
        home screen's box on the one page where both were visible at once.
        The "/" shortcut below keeps the keyboard route to search from every
        screen, without the chrome.
      -->

      <!-- Filled from GET /me. Server-side role enforcement is the real gate;
           this only decides what is worth offering. -->
      <p class="topbar__who"><span id="who-name">…</span><span class="avatar" id="who-initials"></span></p>
    </header>

    <main class="screen">
      <slot />
    </main>

    <script>
      /**
       * "/" reaches search from any admin screen.
       *
       * On the two screens that own a search box — the home screen and
       * /admin/buscar, both marked with data-admin-search — it focuses that
       * box. Everywhere else there is no box to focus (the top bar
       * deliberately has none), so it navigates to /admin/buscar instead.
       * Either way the keystroke means the same thing to the employee.
       *
       * Suppressed while typing: a bare "/" landing in a folio or a
       * patient's name would be actively wrong, not just unhelpful.
       */
      document.addEventListener("keydown", (event) => {
        if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;

        const target = event.target as HTMLElement | null;
        const typing =
          target &&
          (target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.isContentEditable);

        if (typing) return;

        event.preventDefault();

        const search = document.querySelector<HTMLInputElement>("[data-admin-search]");

        if (search) {
          search.focus();
          search.select();
          return;
        }

        location.href = "/admin/buscar";
      });
    </script>
  </body>
</html>
