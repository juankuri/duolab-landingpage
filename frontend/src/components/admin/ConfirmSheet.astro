---
/**
 * A destructive-or-consequential action's dialog: state the consequence in
 * full, require one deliberate click, nothing else. Used by /admin/folio
 * for "Reemplazar archivo…" and "Revocar resultado…" (Slice 6) — publish
 * stays a plain one-click menu action without a sheet, since DEC-013
 * already treats it as the one action worth gating by role rather than by
 * an extra confirmation step.
 *
 * Static markup only; the host page's script fills in per-result copy,
 * wires the buttons, and calls .showModal()/.close(). `showFile` renders a
 * PDF picker inside the sheet (replace needs a new file; revoke does not).
 */
import Dropzone from "./Dropzone.astro";

interface Props {
  id: string;
  title: string;
  confirmLabel: string;
  showFile?: boolean;
}

const { id, title, confirmLabel, showFile = false } = Astro.props;
---

<dialog class="sheet" id={id} aria-labelledby={`${id}-h`}>
  <h2 class="sheet__h" id={`${id}-h`}>{title}</h2>
  <p class="sheet__body" id={`${id}-body`}></p>

  {showFile && <Dropzone id={`${id}-file`} />}

  <p class="status" id={`${id}-status`} role="status" aria-live="polite"></p>

  <div class="actions">
    <button class="btn btn--ghost" id={`${id}-cancel`} type="button">Cancelar</button>
    <button class="btn btn--danger" id={`${id}-confirm`} type="button" disabled={showFile}>
      {confirmLabel}
    </button>
  </div>
</dialog>
