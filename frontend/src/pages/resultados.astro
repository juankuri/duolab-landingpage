---
/**
 * /resultados — public patient lookup and download.
 *
 * No login, no Cloudflare Access: folio + phone + birth date verify the
 * patient against a PUBLISHED result (backend: POST /api/public/results/lookup,
 * GET /api/public/results/:downloadToken/download). Deliberately does NOT use
 * layouts/Layout.astro, same reasoning as admin.astro — this isn't a marketing
 * surface. Unlike admin.astro it is not disallowed in robots.txt and carries
 * no Cloudflare Access assumption: patients reach it by a footer link, not a
 * staff login.
 *
 * noindex, not disallowed: it should not turn up in search results (a lab
 * result lookup form has no reason to be indexed), but it must stay
 * reachable by anyone who clicks the footer link.
 *
 * Every non-2xx that isn't empty-input or rate-limiting — wrong folio, wrong
 * phone, wrong birth date, no such record, not yet published, revoked —
 * renders the same generic message (see scripts/public/lookup.js's
 * lookupErrorMessage). Distinguishing them here would undo the backend's
 * non-enumeration guarantee (DEC-015) for nothing but the appearance of a
 * better error message. The "aún no está listo" reassurance below is static
 * copy for exactly that reason — it is shown always, not only when true, so
 * it never becomes a signal.
 */
import Icon from "../components/Icon.astro";
import WhatsAppButton from "../components/landing/WhatsAppButton.astro";
import PublicFooter from "../components/public/PublicFooter.astro";
import SecondaryHeader from "../components/public/SecondaryHeader.astro";
import content from "../config/site.js";
import "../styles/clients/duolab.css";

const whatsappMessage =
  content.whatsapp.messages.find((m) => m.context === "resultados")?.text ??
  content.whatsapp.messages[0].text;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Checkpoint F performance fix — see AdminLayout.astro's identical
         addition; this page builds its own <head> rather than using that
         layout, so it needs the same preload written here separately. -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>Consulta tus resultados · DúoLab</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <SecondaryHeader links={[{ label: "Volver al inicio", href: "/", icon: "arrow-left" }]} />

    <main class="wrap" id="main">
      <section class="card" aria-labelledby="lookup-h">
        <h1 id="lookup-h" class="card__h">Consulta tus resultados aquí</h1>
        <p class="card__lead" id="lookup-lead">
          Captura los datos que te dio el laboratorio, exactamente como se registraron.
        </p>

        <!--
          novalidate + required is not a contradiction: novalidate turns off
          the browser's own validation bubble (inconsistent styling, fires at
          the wrong time for the copy below), while `required` still gives
          assistive tech the field's required semantics regardless. Custom
          validation lives in the script, not in these attributes.
        -->
        <p class="tiny" id="lookup-required">* campo obligatorio</p>

        <form id="lookup-form" novalidate>
          <div class="field">
            <label for="folio">Folio *</label>
            <input
              id="folio"
              name="folio"
              type="text"
              required
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              inputmode="text"
              aria-describedby="folio-hint"
              placeholder="ABCD-010126-0001"
              autofocus
            />
            <p class="field__hint" id="folio-hint">Lo encuentras en tu ticket de entrega.</p>
            <p class="err" id="err-folio" data-err></p>
          </div>

          <div class="field">
            <label for="phone">Teléfono (10 dígitos) *</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="off"
              inputmode="tel"
              maxlength="10"
              placeholder="9990000000"
            />
            <p class="err" id="err-phone" data-err></p>
          </div>

          <div class="field">
            <label for="birthDate">Fecha de nacimiento *</label>
            <input id="birthDate" name="birthDate" type="date" required min="1900-01-01" />
            <p class="err" id="err-birthDate" data-err></p>
          </div>

          <button class="btn" id="submit" type="submit">Buscar resultado</button>
        </form>

        <p class="status" id="status" role="status" aria-live="polite"></p>

        <div class="result" id="result" hidden>
          <!-- P5 summary card: status badge + who + folio, read before the
               file list itself so identity is confirmed at a glance. -->
          <div class="result__card">
            <span class="badge badge--ready">
              <Icon name="check-circle" weight="fill" size={14} />
              Listo
            </span>
            <p class="result__name" id="result-name"></p>
            <p class="result__folio" id="result-folio"></p>
          </div>
          <p class="result__count" id="result-count"></p>
          <!-- One entry per published study. A folio is an order, so it can
               hold several results released on different dates, and the
               patient is entitled to all of them. -->
          <ul class="files" id="file-list"></ul>
          <p class="result__expiry" id="result-expiry"></p>
          <button class="btn btn--ghost" id="search-again" type="button">
            Buscar otro folio
          </button>
        </div>

        <!--
          Static, unconditional copy — shown on every load, never in response
          to a specific lookup outcome. Answering "is my result not ready
          yet?" (docs/01-domain.md's patient story) this way costs nothing in
          non-enumeration (DEC-015): it says the same thing to every patient
          regardless of what is or isn't true for their folio.
        -->
        <p class="reassurance">
          Si tu resultado aún no está listo, aparecerá aquí en cuanto el laboratorio lo
          publique. Normalmente está disponible el mismo día del estudio.
        </p>

        <div class="help">
          <WhatsAppButton
            phoneNumber={content.whatsapp.phoneNumber}
            message={whatsappMessage}
            label="¿Necesitas ayuda? Escríbenos por WhatsApp"
            variant="outline"
          />
        </div>
      </section>
    </main>

    <PublicFooter />

    <script>
      // Bundled, not is:inline — import.meta.env is only substituted at build
      // time in a processed script, so PUBLIC_API_BASE would otherwise reach the
      // browser as literal source.
      import { API_BASE } from "../scripts/admin/api.js";
      import {
        digitsOnly,
        downloadUrl,
        filesPublishedLabel,
        formatMsLeft,
        formatPublishedAt,
        lookupErrorMessage,
        tokenExpiry,
      } from "../scripts/public/lookup.js";
      import { iconNode } from "../scripts/shared/icons.js";

      const $ = (id) => document.getElementById(id);
      const form = $("lookup-form");
      const cardHeading = $("lookup-h");
      const cardLead = $("lookup-lead");
      const cardRequired = $("lookup-required");
      const submitBtn = $("submit");
      const statusEl = $("status");
      const resultEl = $("result");
      const resultName = $("result-name");
      const resultFolio = $("result-folio");
      const resultCount = $("result-count");
      const resultExpiry = $("result-expiry");
      const fileList = $("file-list");
      const folioInput = $("folio");
      const phoneInput = $("phone");
      const birthDateInput = $("birthDate");

      const FIELDS = ["folio", "phone", "birthDate"];

      const clearFieldErrors = () => {
        for (const name of FIELDS) {
          $(`err-${name}`).textContent = "";
          $(name).removeAttribute("aria-invalid");
        }
      };

      // Every empty field is marked, not just the first — the patient can
      // fix all of them in one pass instead of resubmitting once per field.
      const applyEmptyFieldErrors = ({ folio, phone, birthDate }) => {
        const values = { folio, phone, birthDate };
        let firstInvalid = null;

        for (const name of FIELDS) {
          if (values[name].trim()) continue;
          $(`err-${name}`).textContent = "Falta este dato.";
          $(name).setAttribute("aria-invalid", "true");
          firstInvalid ??= $(name);
        }

        return firstInvalid;
      };

      // Computed at load, not at build time (this is a static page) — a
      // build-time date would go stale the day after deploy.
      birthDateInput.max = new Date().toISOString().slice(0, 10);

      const setStatus = (message, tone) => {
        statusEl.textContent = message || "";
        if (tone) statusEl.dataset.tone = tone;
        else delete statusEl.dataset.tone;
      };

      // The card is one surface with two states, so its heading has to say
      // which one you are in. Leaving "Consulta tus resultados aquí" (plus
      // the "fill these in" lead and the required-field note) above a
      // finished result reads as though the search never happened.
      const FORM_HEADING = cardHeading.textContent;
      const RESULT_HEADING = "Tu resultado";

      const showForm = () => {
        resultEl.hidden = true;
        form.hidden = false;
        cardHeading.textContent = FORM_HEADING;
        cardLead.hidden = false;
        cardRequired.hidden = false;
      };

      /* ---------- download-token expiry (5 minutes, previously discarded) ---------- */

      let expiryTimer = null;

      const clearExpiryTimer = () => {
        if (expiryTimer) clearInterval(expiryTimer);
        expiryTimer = null;
      };

      const handleExpired = () => {
        clearExpiryTimer();
        fileList.replaceChildren();
        showForm();
        setStatus(
          "Tus enlaces para descargar expiraron. Busca tu resultado de nuevo.",
          "error",
        );
        folioInput.focus();
      };

      const tickExpiry = (expiresAt) => {
        const { expired, msLeft } = tokenExpiry(expiresAt);

        if (expired) {
          handleExpired();
          return;
        }

        resultExpiry.textContent = `Estos enlaces son válidos ${formatMsLeft(msLeft)} más.`;
      };

      /* ---------- lookup ---------- */

      /**
       * Fetches one file as a Blob rather than ever pointing a navigation at
       * `downloadUrl()` directly. A plain `<a href>` carrying the token is a
       * navigation, so the token would land in the address bar, in browser
       * history, and in session-restore state — a `Content-Disposition`
       * header only ever affects what a navigation *does with* the
       * response, not whether the URL itself is exposed. `fetch()` doesn't
       * navigate anywhere, so the token in the request URL is never shown
       * or stored by the browser. No new backend route: this calls the same
       * `GET .../download/:fileId` the old link pointed at.
       */
      async function fetchResultBlob(downloadToken, fileId) {
        const res = await fetch(downloadUrl(API_BASE, downloadToken, fileId));
        if (!res.ok) throw new Error(`download failed: ${res.status}`);
        return res.blob();
      }

      /** One row per published study: its glyph, name, date, view + download. */
      const fileRow = (folio, downloadToken, result, index) => {
        const li = document.createElement("li");
        li.className = "file";

        const head = document.createElement("div");
        head.className = "file__head";
        head.append(iconNode("file", { size: 20, className: "file__icon" }));

        const name = document.createElement("p");
        name.className = "file__name";
        // The stored filename is the lab's, and may be unhelpful ("nuevo.pdf").
        // Numbering gives the patient something stable to refer to on the
        // phone with the lab, whatever the file happens to be called.
        name.textContent = `${index + 1}. ${result.filename}`;

        const meta = document.createElement("p");
        meta.className = "file__meta";
        const published = formatPublishedAt(result.publishedAt);
        meta.textContent = published ? `Publicado el ${published}` : "";

        const actions = document.createElement("div");
        actions.className = "file__actions";

        const status = document.createElement("p");
        status.className = "file__status";
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");

        const withPending = (button, label, run) => {
          button.addEventListener("click", async () => {
            if (button.disabled) return; // duplicate-click guard
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            status.textContent = `${label}…`;
            try {
              await run();
              status.textContent = "";
            } catch {
              status.textContent =
                "No pudimos abrir este archivo. Revisa tu conexión e inténtalo de nuevo.";
            } finally {
              button.disabled = false;
              button.removeAttribute("aria-busy");
            }
          });
        };

        // Icon beside the label, never instead of it — Icon.astro's contract,
        // and the reason these keep their aria-label naming the actual file.
        const withIcon = (button, name, label) => {
          button.append(iconNode(name, { size: 16 }), document.createTextNode(label));
        };

        const viewBtn = document.createElement("button");
        viewBtn.type = "button";
        viewBtn.className = "btn btn--ghost btn--sm";
        withIcon(viewBtn, "eye", "Ver");
        viewBtn.setAttribute("aria-label", `Ver ${result.filename}`);
        withPending(viewBtn, "Abriendo", async () => {
          // A tab opened synchronously on the click, then pointed at the
          // blob: URL once the fetch resolves — window.open() called only
          // after an await risks the popup blocker; opening blank first,
          // inside the same click handler, keeps the user-gesture context.
          const tab = window.open("", "_blank", "noopener");
          try {
            const blob = await fetchResultBlob(downloadToken, result.fileId);
            const blobUrl = URL.createObjectURL(blob);
            if (tab) {
              tab.location.href = blobUrl;
            } else {
              // Popup blocked outright — fall back to the same tab. Still a
              // blob: URL, still no token, just not a new tab.
              location.href = blobUrl;
            }
            // Revoked on a delay, not immediately: the new tab needs the
            // URL to still resolve when it finishes loading it.
            setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
          } catch (error) {
            tab?.close();
            throw error;
          }
        });

        const downloadBtn = document.createElement("button");
        downloadBtn.type = "button";
        downloadBtn.className = "btn btn--sm";
        withIcon(downloadBtn, "download", "Descargar");
        downloadBtn.setAttribute("aria-label", `Descargar ${result.filename}`);
        withPending(downloadBtn, "Descargando", async () => {
          const blob = await fetchResultBlob(downloadToken, result.fileId);
          const blobUrl = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = blobUrl;
          a.download = result.filename || "resultado.pdf";
          document.body.append(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(blobUrl), 5_000);
        });

        actions.append(viewBtn, downloadBtn);

        const body = document.createElement("div");
        body.className = "file__body";
        body.append(name);
        if (meta.textContent) body.append(meta);

        // Glyph, then what the file is, then what you can do with it — one
        // horizontal row (P5), wrapping the actions onto their own line only
        // when a long lab filename leaves no room for them.
        head.append(body, actions);

        li.append(head, status);
        return li;
      };

      const showResult = (folio, payload) => {
        const results = Array.isArray(payload.results) ? payload.results : [];

        form.hidden = true;
        resultEl.hidden = false;
        cardHeading.textContent = RESULT_HEADING;
        cardLead.hidden = true;
        cardRequired.hidden = true;
        // patientDisplayName is given names in full, surnames as an
        // initial (backend/src/domain/masking.ts) — enough for the patient
        // to recognize it's theirs, without the full legal name appearing
        // on a page nothing has authenticated beyond folio+phone+birthDate.
        resultName.textContent = payload.patientDisplayName ?? "";
        resultName.hidden = !payload.patientDisplayName;
        resultFolio.textContent = `Folio ${folio}`;
        resultCount.textContent = filesPublishedLabel(results.length);

        fileList.replaceChildren(
          ...results.map((result, index) =>
            fileRow(folio, payload.downloadToken, result, index),
          ),
        );

        fileList.querySelector("button")?.focus();

        clearExpiryTimer();
        tickExpiry(payload.expiresAt);
        expiryTimer = setInterval(() => tickExpiry(payload.expiresAt), 15_000);
      };

      // As-you-type digit filter — a phone typed with spaces or punctuation
      // ("938 123 4567") is otherwise indistinguishable from a wrong number
      // once trimmed, and rebounds as the generic failure for no reason.
      phoneInput.addEventListener("input", () => {
        phoneInput.value = digitsOnly(phoneInput.value).slice(0, 10);
      });

      // Clears a field's own error the moment the patient starts fixing it,
      // rather than making them resubmit to find out it's gone.
      for (const input of [folioInput, phoneInput, birthDateInput]) {
        input.addEventListener("input", () => {
          $(`err-${input.id}`).textContent = "";
          input.removeAttribute("aria-invalid");
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        // Sent as a POST body only — never a query string or localStorage —
        // so verification data never lands in a URL, history entry or log.
        const folio = folioInput.value.trim();
        const phone = phoneInput.value.trim();
        const birthDate = birthDateInput.value;

        clearFieldErrors();
        const firstInvalid = applyEmptyFieldErrors({ folio, phone, birthDate });
        if (firstInvalid) {
          // Purely a client-side check — no request was made, so saying so
          // plainly (rather than the generic "no encontramos…") leaks
          // nothing about any folio. The per-field errors carry the detail;
          // this line is the one already-announced status the patient will
          // notice first.
          setStatus("Completa los datos marcados para buscar tu resultado.", "error");
          firstInvalid.focus();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.setAttribute("aria-busy", "true");
        setStatus("Buscando…");

        try {
          const res = await fetch(`${API_BASE}/api/public/results/lookup`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ folio, phone, birthDate }),
          });

          if (!res.ok) {
            setStatus(lookupErrorMessage(res.status), "error");
            return;
          }

          const payload = await res.json();
          setStatus("");
          showResult(folio, payload);
        } catch {
          setStatus("Ocurrió un error. Intenta de nuevo más tarde.", "error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.removeAttribute("aria-busy");
        }
      });

      $("search-again").addEventListener("click", () => {
        clearExpiryTimer();
        fileList.replaceChildren();
        form.reset();
        setStatus("");
        showForm();
        folioInput.focus();
      });
    </script>

    <style>
      :global(body) {
        margin: 0;
        font-family: var(--font-body);
        color: var(--text-primary);
        background: var(--color-surface-muted);
        line-height: 1.5;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      .skip-link {
        position: absolute;
        top: -40px;
        left: var(--space-xs);
        z-index: var(--z-toast);
        padding: var(--space-2xs) var(--space-sm);
        background: var(--color-primary);
        color: var(--text-on-primary);
        border-radius: var(--radius-sm);
        text-decoration: none;
        font-weight: 600;
        transition: top var(--duration-fast) var(--ease-out);
      }

      /* :focus-visible, not :focus — a page reached via a redirect (e.g.
         back from a Cloudflare Access login) can land initial DOM focus on
         the first focusable element without any keyboard interaction, and
         :focus alone would show this pill on every such load. */
      .skip-link:focus-visible {
        top: var(--space-xs);
      }

      /* The .bar* rules that used to live here moved into
         components/public/SecondaryHeader.astro along with the markup —
         same header, now shared with the legal pages and /404. */

      /* Mobile-first: a single column that never exceeds a comfortable
         reading/typing width, centered once there's room for it. */
      .wrap {
        display: flex;
        justify-content: center;
        padding: var(--space-md);
      }

      .card {
        width: 100%;
        max-width: 26rem;
        background: var(--color-surface);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-md);
        padding: var(--space-md);
      }

      @media (min-width: 480px) {
        .wrap {
          padding: var(--space-xl) var(--space-md);
        }
      }

      /*
       * Above 768px the card was still capped at 26rem — a narrow column
       * centered in whitespace, whether the page was showing the lookup
       * form or a successful result with a file list. The form legitimately
       * wants a narrow measure (three short fields, one button); the
       * result's file list does not, especially with real filenames. Widen
       * the shell, then cap the form-and-copy elements back to the
       * original measure so only the result content gets the extra room.
       */
      @media (min-width: 768px) {
        .card {
          max-width: 640px;
        }

        .card__h,
        .card__lead,
        #lookup-required,
        #lookup-form,
        .status,
        .reassurance,
        .help {
          max-width: 26rem;
          /* Capping the width without centering left these flush against
             the card's left edge, with the extra room the wider .card
             gained sitting as dead space on the right — the opposite of
             what widening the shell was for. */
          margin-inline: auto;
        }
      }

      .card__h {
        margin: 0 0 var(--space-xs);
        font-size: var(--font-size-title);
        font-weight: var(--font-weight-title);
      }

      .card__lead {
        margin: 0 0 var(--space-md);
        color: var(--text-secondary);
        font-size: var(--font-size-label);
      }

      .field {
        margin-bottom: var(--space-sm);
      }

      label {
        display: block;
        margin-bottom: var(--space-3xs);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-medium);
      }

      .field__hint {
        margin: var(--space-3xs) 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      /* Reserves its line even when empty, so an error appearing doesn't
         shift the field below it. */
      .err {
        margin: var(--space-3xs) 0 0;
        min-height: 1.1em;
        font-size: 0.8rem;
        color: var(--color-danger);
      }

      input[aria-invalid="true"] {
        border-color: var(--color-danger);
      }

      input {
        width: 100%;
        /* 14px vertical padding + the explicit 16px line brings the field to
           a comfortable touch target — both stay literal on purpose, see
           admin.css's identical rule. 12px horizontal is a real scale step
           (--space-2xs). */
        padding: 14px var(--space-2xs);
        font-size: 16px;
        font-family: inherit;
        color: inherit;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
      }

      input:focus-visible,
      a:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .status {
        margin: var(--space-sm) 0 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .status[data-tone="error"] {
        color: var(--color-danger);
      }

      .status:empty {
        display: none;
      }

      /* P5 summary card — status badge, patient name, folio. Leads the
         results state so identity is confirmed before the file list. */
      .result__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        margin: 0 0 var(--space-sm);
        padding: var(--space-2xs);
        background: var(--color-success-surface);
        border: 1px solid var(--color-success-border);
        border-radius: var(--radius-sm);
      }

      .badge {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: var(--space-3xs);
        padding: 2px var(--space-2xs);
        font-size: 0.8rem;
        font-weight: var(--font-weight-title);
        border-radius: var(--radius-pill);
      }

      .badge--ready {
        color: var(--color-success);
        background: var(--color-surface);
      }

      .result__name {
        margin: 0;
        font-weight: var(--font-weight-title);
      }

      .result__name[hidden] {
        display: none;
      }

      .result__folio {
        margin: 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .result__count {
        margin: 0 0 var(--space-xs);
        font-weight: var(--font-weight-medium);
        font-size: var(--font-size-label);
      }

      .result__expiry {
        margin: var(--space-xs) 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .result__expiry:empty {
        display: none;
      }

      .reassurance {
        margin: var(--space-md) 0 0;
        padding-top: var(--space-sm);
        border-top: 1px solid var(--color-surface-soft);
        font-size: 0.85rem;
        color: var(--text-secondary);
      }

      .help {
        margin-top: var(--space-sm);
        display: flex;
        justify-content: center;
      }

      .help :global(.wa-button) {
        width: 100%;
      }
    </style>

    <!--
      Global, not scoped, and that is load-bearing rather than a shortcut.

      Astro stamps its scoping attribute (data-astro-cid-…) onto elements
      present in the template at build time. The file rows below are built
      at runtime by this page's script with createElement, so they never
      receive it and a scoped rule never matches them — the rows had been
      rendering as unstyled <li>s with native buttons for exactly this
      reason. Same reason styles/admin.css is global; see its header.

      .btn lives here too because both worlds use it: #search-again is in
      the template, the row's Ver/Descargar buttons are not. Splitting the
      base rule across a scoped and a global block would mean maintaining
      it twice.
    -->
    <style is:global>
      button:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .btn {
        display: block;
        width: 100%;
        margin-top: var(--space-sm);
        /* 14px stays literal, same touch-target reasoning as the input
           rule in the scoped block above. */
        padding: 14px var(--space-sm);
        font: inherit;
        font-weight: var(--font-weight-title);
        text-align: center;
        text-decoration: none;
        color: var(--text-on-primary);
        background: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: var(--radius-sm);
        cursor: pointer;
      }

      .btn:hover:not(:disabled) {
        background: var(--color-primary-dark);
      }

      .btn:disabled,
      .btn[aria-disabled="true"] {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .btn--ghost {
        color: var(--color-primary);
        background: transparent;
      }

      .btn--ghost:hover:not(:disabled) {
        background: var(--color-surface-soft);
      }

      .files {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
      }

      .file {
        padding: var(--space-2xs);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
      }

      /* P5's file row: glyph · name+date · actions, on one line. `wrap` is
         the escape valve for long lab filenames — the actions drop to their
         own line rather than crushing the name into an unreadable sliver. */
      .file__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs) var(--space-2xs);
      }

      .file__icon {
        flex: none;
        color: var(--color-primary);
      }

      .file__body {
        flex: 1 1 9rem;
        min-width: 0;
      }

      .file__name {
        margin: 0;
        font-weight: var(--font-weight-medium);
        /* Lab filenames can be long and unbroken; let them wrap rather than
           push the download button off a narrow phone. */
        overflow-wrap: anywhere;
      }

      .file__meta {
        margin: 2px 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .file__actions {
        display: flex;
        flex: none;
        gap: var(--space-3xs);
        /* Keeps the actions hard right when a long filename wraps them onto
           their own line. */
        margin-left: auto;
      }

      /* Download is the thing the patient came here to do, so it is the one
         filled button on the row; "Ver" stays quiet beside it. */
      .file__actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3xs);
        width: auto;
        margin-top: 0;
        padding: var(--space-xs) var(--space-2xs);
        font-size: var(--font-size-label);
        white-space: nowrap;
      }

      /* Only inside a row: "Ver" sits beside a filled "Descargar", so an
         outline on it would read as a second equally-weighted button.
         The page-level ghost ("Buscar otro folio") keeps its border. */
      .file__actions .btn--ghost {
        border-color: transparent;
      }

      .file__status {
        margin: var(--space-xs) 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .file__status:empty {
        display: none;
      }
    </style>
  </body>
</html>
