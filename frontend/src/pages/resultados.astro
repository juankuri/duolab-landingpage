---
/**
 * /resultados — public patient lookup and download.
 *
 * No login, no Cloudflare Access: folio + phone + birth date verify the
 * patient against a PUBLISHED result (backend: POST /api/public/results/lookup,
 * GET /api/public/results/:downloadToken/download). Deliberately does NOT use
 * layouts/Layout.astro, same reasoning as admin.astro — this isn't a marketing
 * surface. Unlike admin.astro it is not disallowed in robots.txt and carries
 * no Cloudflare Access assumption: patients reach it by a footer link, not a
 * staff login.
 *
 * noindex, not disallowed: it should not turn up in search results (a lab
 * result lookup form has no reason to be indexed), but it must stay
 * reachable by anyone who clicks the footer link.
 *
 * Every non-2xx that isn't empty-input or rate-limiting — wrong folio, wrong
 * phone, wrong birth date, no such record, not yet published, revoked —
 * renders the same generic message (see scripts/public/lookup.js's
 * lookupErrorMessage). Distinguishing them here would undo the backend's
 * non-enumeration guarantee (DEC-015) for nothing but the appearance of a
 * better error message. The "aún no está listo" reassurance below is static
 * copy for exactly that reason — it is shown always, not only when true, so
 * it never becomes a signal.
 */
import WhatsAppButton from "../components/landing/WhatsAppButton.astro";
import content from "../config/site.js";
import "../styles/clients/duolab.css";

const whatsappMessage =
  content.whatsapp.messages.find((m) => m.context === "resultados")?.text ??
  content.whatsapp.messages[0].text;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Consulta tu resultado · DúoLab</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="bar">
      <a class="bar__brand" href="/">
        <img src="/logo/logo-mark.svg" alt="" width="28" height="28" />
        <span class="bar__name">dúolab</span>
      </a>
      <!-- The logo alone was the only way back, which reads as decoration
           rather than navigation. An explicit, labelled link costs nothing
           and is the difference between "I'm stuck here" and "I can leave". -->
      <a class="bar__back" href="/">← Volver al inicio</a>
    </header>

    <main class="wrap" id="main">
      <section class="card" aria-labelledby="lookup-h">
        <h1 id="lookup-h" class="card__h">Consulta tu resultado</h1>
        <p class="card__lead">
          Captura los datos exactamente como se registraron en el laboratorio.
        </p>

        <!--
          novalidate + required is not a contradiction: novalidate turns off
          the browser's own validation bubble (inconsistent styling, fires at
          the wrong time for the copy below), while `required` still gives
          assistive tech the field's required semantics regardless. Custom
          validation lives in the script, not in these attributes.
        -->
        <p class="tiny">* campo obligatorio</p>

        <form id="lookup-form" novalidate>
          <div class="field">
            <label for="folio">Folio *</label>
            <input
              id="folio"
              name="folio"
              type="text"
              required
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              inputmode="text"
              aria-describedby="folio-hint"
              placeholder="JPKR-050826-0131"
              autofocus
            />
            <p class="field__hint" id="folio-hint">Lo encuentras en tu ticket de entrega.</p>
            <p class="err" id="err-folio" data-err></p>
          </div>

          <div class="field">
            <label for="phone">Teléfono (10 dígitos) *</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="off"
              inputmode="tel"
              maxlength="10"
              placeholder="9381234567"
            />
            <p class="err" id="err-phone" data-err></p>
          </div>

          <div class="field">
            <label for="birthDate">Fecha de nacimiento *</label>
            <input id="birthDate" name="birthDate" type="date" required min="1900-01-01" />
            <p class="err" id="err-birthDate" data-err></p>
          </div>

          <button class="btn" id="submit" type="submit">Buscar resultado</button>
        </form>

        <p class="status" id="status" role="status" aria-live="polite"></p>

        <div class="result" id="result" hidden>
          <p class="result__msg" id="result-msg"></p>
          <!-- One entry per published study. A folio is an order, so it can
               hold several results released on different dates, and the
               patient is entitled to all of them. -->
          <ul class="files" id="file-list"></ul>
          <p class="result__expiry" id="result-expiry"></p>
          <button class="btn btn--ghost" id="search-again" type="button">
            Buscar otro folio
          </button>
        </div>

        <!--
          Static, unconditional copy — shown on every load, never in response
          to a specific lookup outcome. Answering "is my result not ready
          yet?" (docs/01-domain.md's patient story) this way costs nothing in
          non-enumeration (DEC-015): it says the same thing to every patient
          regardless of what is or isn't true for their folio.
        -->
        <p class="reassurance">
          Si tu resultado aún no está listo, aparecerá aquí en cuanto el laboratorio lo
          publique. Normalmente está disponible el mismo día del estudio.
        </p>

        <div class="help">
          <WhatsAppButton
            phoneNumber={content.whatsapp.phoneNumber}
            message={whatsappMessage}
            label="Ayuda por WhatsApp"
            variant="outline"
          />
        </div>
      </section>
    </main>

    <script>
      // Bundled, not is:inline — import.meta.env is only substituted at build
      // time in a processed script, so PUBLIC_API_BASE would otherwise reach the
      // browser as literal source.
      import { API_BASE } from "../scripts/admin/api.js";
      import {
        digitsOnly,
        downloadUrl,
        formatMsLeft,
        formatPublishedAt,
        lookupErrorMessage,
        resultsHeading,
        tokenExpiry,
      } from "../scripts/public/lookup.js";

      const $ = (id) => document.getElementById(id);
      const form = $("lookup-form");
      const submitBtn = $("submit");
      const statusEl = $("status");
      const resultEl = $("result");
      const resultMsg = $("result-msg");
      const resultExpiry = $("result-expiry");
      const fileList = $("file-list");
      const folioInput = $("folio");
      const phoneInput = $("phone");
      const birthDateInput = $("birthDate");

      const FIELDS = ["folio", "phone", "birthDate"];

      const clearFieldErrors = () => {
        for (const name of FIELDS) {
          $(`err-${name}`).textContent = "";
          $(name).removeAttribute("aria-invalid");
        }
      };

      // Every empty field is marked, not just the first — the patient can
      // fix all of them in one pass instead of resubmitting once per field.
      const applyEmptyFieldErrors = ({ folio, phone, birthDate }) => {
        const values = { folio, phone, birthDate };
        let firstInvalid = null;

        for (const name of FIELDS) {
          if (values[name].trim()) continue;
          $(`err-${name}`).textContent = "Falta este dato.";
          $(name).setAttribute("aria-invalid", "true");
          firstInvalid ??= $(name);
        }

        return firstInvalid;
      };

      // Computed at load, not at build time (this is a static page) — a
      // build-time date would go stale the day after deploy.
      birthDateInput.max = new Date().toISOString().slice(0, 10);

      const setStatus = (message, tone) => {
        statusEl.textContent = message || "";
        if (tone) statusEl.dataset.tone = tone;
        else delete statusEl.dataset.tone;
      };

      const showForm = () => {
        resultEl.hidden = true;
        form.hidden = false;
      };

      /* ---------- download-token expiry (5 minutes, previously discarded) ---------- */

      let expiryTimer = null;

      const clearExpiryTimer = () => {
        if (expiryTimer) clearInterval(expiryTimer);
        expiryTimer = null;
      };

      const handleExpired = () => {
        clearExpiryTimer();
        fileList.replaceChildren();
        showForm();
        setStatus(
          "Tus enlaces para descargar expiraron. Busca tu resultado de nuevo.",
          "error",
        );
        folioInput.focus();
      };

      const tickExpiry = (expiresAt) => {
        const { expired, msLeft } = tokenExpiry(expiresAt);

        if (expired) {
          handleExpired();
          return;
        }

        resultExpiry.textContent = `Estos enlaces son válidos ${formatMsLeft(msLeft)} más.`;
      };

      /* ---------- lookup ---------- */

      /** One row per published study: its name, its date, and its own download. */
      const fileRow = (folio, downloadToken, result, index) => {
        const li = document.createElement("li");
        li.className = "file";

        const name = document.createElement("p");
        name.className = "file__name";
        // The stored filename is the lab's, and may be unhelpful ("nuevo.pdf").
        // Numbering gives the patient something stable to refer to on the
        // phone with the lab, whatever the file happens to be called.
        name.textContent = `${index + 1}. ${result.filename}`;

        const meta = document.createElement("p");
        meta.className = "file__meta";
        const published = formatPublishedAt(result.publishedAt);
        meta.textContent = published ? `Publicado el ${published}` : "";

        const link = document.createElement("a");
        link.className = "btn btn--sm";
        link.href = downloadUrl(API_BASE, downloadToken, result.fileId);
        link.textContent = "Descargar PDF";
        // Names the study rather than repeating "Descargar PDF" N times,
        // which is what a screen reader would otherwise announce.
        link.setAttribute("aria-label", `Descargar ${result.filename}`);

        li.append(name);
        if (meta.textContent) li.append(meta);
        li.append(link);
        return li;
      };

      const showResult = (folio, payload) => {
        const results = Array.isArray(payload.results) ? payload.results : [];

        form.hidden = true;
        resultEl.hidden = false;
        resultMsg.textContent = `${resultsHeading(results.length)} del folio ${folio}.`;

        fileList.replaceChildren(
          ...results.map((result, index) =>
            fileRow(folio, payload.downloadToken, result, index),
          ),
        );

        fileList.querySelector("a")?.focus();

        clearExpiryTimer();
        tickExpiry(payload.expiresAt);
        expiryTimer = setInterval(() => tickExpiry(payload.expiresAt), 15_000);
      };

      // As-you-type digit filter — a phone typed with spaces or punctuation
      // ("938 123 4567") is otherwise indistinguishable from a wrong number
      // once trimmed, and rebounds as the generic failure for no reason.
      phoneInput.addEventListener("input", () => {
        phoneInput.value = digitsOnly(phoneInput.value).slice(0, 10);
      });

      // Clears a field's own error the moment the patient starts fixing it,
      // rather than making them resubmit to find out it's gone.
      for (const input of [folioInput, phoneInput, birthDateInput]) {
        input.addEventListener("input", () => {
          $(`err-${input.id}`).textContent = "";
          input.removeAttribute("aria-invalid");
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        // Sent as a POST body only — never a query string or localStorage —
        // so verification data never lands in a URL, history entry or log.
        const folio = folioInput.value.trim();
        const phone = phoneInput.value.trim();
        const birthDate = birthDateInput.value;

        clearFieldErrors();
        const firstInvalid = applyEmptyFieldErrors({ folio, phone, birthDate });
        if (firstInvalid) {
          // Purely a client-side check — no request was made, so saying so
          // plainly (rather than the generic "no encontramos…") leaks
          // nothing about any folio. The per-field errors carry the detail;
          // this line is the one already-announced status the patient will
          // notice first.
          setStatus("Completa los datos marcados para buscar tu resultado.", "error");
          firstInvalid.focus();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.setAttribute("aria-busy", "true");
        setStatus("Buscando…");

        try {
          const res = await fetch(`${API_BASE}/api/public/results/lookup`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ folio, phone, birthDate }),
          });

          if (!res.ok) {
            setStatus(lookupErrorMessage(res.status), "error");
            return;
          }

          const payload = await res.json();
          setStatus("");
          showResult(folio, payload);
        } catch {
          setStatus("Ocurrió un error. Intenta de nuevo más tarde.", "error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.removeAttribute("aria-busy");
        }
      });

      $("search-again").addEventListener("click", () => {
        clearExpiryTimer();
        fileList.replaceChildren();
        form.reset();
        setStatus("");
        showForm();
        folioInput.focus();
      });
    </script>

    <style>
      :global(body) {
        margin: 0;
        font-family: var(--font-body);
        color: var(--text-primary);
        background: var(--color-surface-muted);
        line-height: 1.5;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      .skip-link {
        position: absolute;
        top: -40px;
        left: 8px;
        z-index: var(--z-toast);
        padding: 10px 16px;
        background: var(--color-primary);
        color: var(--text-on-primary);
        border-radius: var(--radius-sm);
        text-decoration: none;
        font-weight: 600;
        transition: top var(--duration-fast) var(--ease-out);
      }

      .skip-link:focus {
        top: 8px;
      }

      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-soft);
      }

      .bar__back {
        color: var(--color-primary);
        font-size: var(--font-size-label);
        text-decoration: none;
        /* Comfortable to hit on a phone without turning the header into a
           toolbar. */
        padding: 8px 4px;
      }

      .bar__back:hover {
        text-decoration: underline;
      }

      .bar__brand {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        text-decoration: none;
        color: inherit;
      }

      .bar__name {
        font-weight: var(--font-weight-heading);
        color: var(--color-primary);
      }

      /* Mobile-first: a single column that never exceeds a comfortable
         reading/typing width, centered once there's room for it. */
      .wrap {
        display: flex;
        justify-content: center;
        padding: var(--space-md);
      }

      .card {
        width: 100%;
        max-width: 26rem;
        background: var(--color-surface);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-md);
        padding: var(--space-md);
      }

      @media (min-width: 480px) {
        .wrap {
          padding: var(--space-xl) var(--space-md);
        }
      }

      .card__h {
        margin: 0 0 var(--space-xs);
        font-size: var(--font-size-title);
        font-weight: var(--font-weight-title);
      }

      .card__lead {
        margin: 0 0 var(--space-md);
        color: var(--text-secondary);
        font-size: var(--font-size-label);
      }

      .field {
        margin-bottom: var(--space-sm);
      }

      label {
        display: block;
        margin-bottom: 4px;
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-medium);
      }

      .field__hint {
        margin: 4px 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      /* Reserves its line even when empty, so an error appearing doesn't
         shift the field below it. */
      .err {
        margin: 4px 0 0;
        min-height: 1.1em;
        font-size: 0.8rem;
        color: var(--color-danger);
      }

      input[aria-invalid="true"] {
        border-color: var(--color-danger);
      }

      input {
        width: 100%;
        /* 16px avoids iOS Safari zooming in on focus, and the taller
           padding keeps every field a comfortable touch target. */
        padding: 14px 12px;
        font-size: 16px;
        font-family: inherit;
        color: inherit;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
      }

      input:focus-visible,
      button:focus-visible,
      a:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .btn {
        display: block;
        width: 100%;
        margin-top: var(--space-sm);
        padding: 14px 16px;
        font: inherit;
        font-weight: var(--font-weight-title);
        text-align: center;
        text-decoration: none;
        color: var(--text-on-primary);
        background: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: var(--radius-sm);
        cursor: pointer;
      }

      .btn:hover:not(:disabled) {
        background: var(--color-primary-dark);
      }

      .btn:disabled,
      .btn[aria-disabled="true"] {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .btn--ghost {
        color: var(--color-primary);
        background: transparent;
      }

      .btn--ghost:hover {
        background: var(--color-surface-soft);
      }

      .status {
        margin: var(--space-sm) 0 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .status[data-tone="error"] {
        color: var(--color-danger);
      }

      .status:empty {
        display: none;
      }

      .result__msg {
        margin: 0 0 var(--space-sm);
        font-weight: var(--font-weight-medium);
      }

      .files {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
      }

      .file {
        padding: 12px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
      }

      .file__name {
        margin: 0;
        font-weight: var(--font-weight-medium);
        /* Lab filenames can be long and unbroken; let them wrap rather than
           push the download button off a narrow phone. */
        overflow-wrap: anywhere;
      }

      .file__meta {
        margin: 2px 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .file .btn {
        margin-top: 10px;
        /* Each row carries its own download, so these are secondary to the
           page as a whole — outlined rather than N solid purple blocks. */
        color: var(--color-primary);
        background: transparent;
        padding: 10px 14px;
      }

      .file .btn:hover {
        background: var(--color-surface-soft);
      }

      .result__expiry {
        margin: var(--space-xs) 0 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .result__expiry:empty {
        display: none;
      }

      .reassurance {
        margin: var(--space-md) 0 0;
        padding-top: var(--space-sm);
        border-top: 1px solid var(--color-surface-soft);
        font-size: 0.85rem;
        color: var(--text-secondary);
      }

      .help {
        margin-top: var(--space-sm);
        display: flex;
        justify-content: center;
      }

      .help :global(.wa-button) {
        width: 100%;
      }
    </style>
  </body>
</html>
