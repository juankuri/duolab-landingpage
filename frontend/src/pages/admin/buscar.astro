---
/**
 * /admin/buscar?q=… — unified search results.
 *
 * Backs onto GET /search, which matches a folio (exact/prefix), a patient
 * name (accent-insensitive substring) and a phone (digit prefix) in one
 * query. Two groups, because they answer different questions: "which folio"
 * vs "which patient" — a patient with three folios is one row here, not
 * three.
 *
 * This page IS the search, so AdminLayout's topbar box is hidden — showing
 * it here would be two search boxes doing the same thing on one screen.
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
import Icon from "../../components/Icon.astro";
---

<AdminLayout title="Buscar">
  <nav class="crumb" aria-label="Ubicación">
    <a href="/admin">Inicio</a>
    <Icon name="chevron" size={14} />
    <b>Buscar</b>
  </nav>

  <form class="row" id="search-form" role="search" style="margin-bottom: 16px;">
    <label class="vh" for="q">Buscar folio, nombre o teléfono</label>
    <input
      id="q"
      name="q"
      type="search"
      data-admin-search
      autocomplete="off"
      placeholder="Folio · nombre · teléfono…"
    />
    <button class="btn" type="submit">Buscar</button>
  </form>

  <div id="results">
    <section id="folios-section" hidden>
      <h2 class="sect">Folios</h2>
      <ul class="results" id="folios-list"></ul>
    </section>

    <section id="patients-section" hidden>
      <h2 class="sect">Pacientes</h2>
      <ul class="results" id="patients-list"></ul>
    </section>
  </div>

  <div class="empty" id="empty" hidden>
    <p class="empty__title" id="empty-title">Busca un folio o un paciente</p>
    <p class="empty__sub" id="empty-sub">
      Escribe un folio, un nombre o un teléfono arriba.
    </p>
    <a class="btn" id="empty-create" href="/admin/nuevo" hidden>
      + Crear un paciente nuevo
    </a>
  </div>

  <p class="status" id="status" role="status" aria-live="polite"></p>

  <script>
    import { apiJson, withRef } from "../../scripts/admin/api.js";
    import { debounce } from "../../scripts/admin/debounce.js";
    import { folioRowNode, patientRowNode, setStatusLine } from "../../scripts/admin/render.js";

    const $ = (id) => document.getElementById(id);

    const showEmpty = (title, sub, offerCreate) => {
      $("folios-section").hidden = true;
      $("patients-section").hidden = true;
      $("empty-create").hidden = !offerCreate;
      $("empty").hidden = false;
      $("empty-title").textContent = title;
      $("empty-sub").textContent = sub;
    };

    const render = (payload, query) => {
      const hasFolios = payload.folios.length > 0;
      const hasPatients = payload.patients.length > 0;

      if (!hasFolios && !hasPatients) {
        showEmpty(
          `No encontramos resultados para "${query}"`,
          "Revisa el folio, el nombre o el teléfono.",
          true,
        );
        return;
      }

      $("empty").hidden = true;

      $("folios-section").hidden = !hasFolios;
      $("folios-list").replaceChildren(...payload.folios.map((folio) => folioRowNode(folio)));

      $("patients-section").hidden = !hasPatients;
      $("patients-list").replaceChildren(...payload.patients.map(patientRowNode));
    };

    // Guards against a slow response from an older query overwriting the
    // results of a newer one typed while it was in flight — real-time search
    // fires one request per pause, but nothing stops two from overlapping.
    let requestId = 0;

    const search = async (query) => {
      const thisRequest = ++requestId;

      if (!query) {
        showEmpty("Busca un folio o un paciente", "Escribe un folio, un nombre o un teléfono arriba.", false);
        setStatusLine($("status"), "");
        return;
      }

      setStatusLine($("status"), "Buscando…");
      const { ok, payload } = await apiJson(`/search?q=${encodeURIComponent(query)}`);
      if (thisRequest !== requestId) return; // superseded by a newer query

      if (!ok) {
        setStatusLine($("status"), withRef(payload, "No se pudo buscar."), "error");
        return;
      }

      render(payload, query);
      setStatusLine($("status"), "");
    };

    const syncUrl = (query) => {
      const url = new URL(location.href);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    };

    // Real-time search: typing searches automatically after a short pause,
    // rather than requiring Enter or the button. 250ms is short enough to
    // feel live, long enough that a normal typing burst produces one
    // request, not one per keystroke.
    const debouncedSearch = debounce((query) => {
      syncUrl(query);
      search(query);
    }, 250);

    $("q").addEventListener("input", () => {
      debouncedSearch($("q").value.trim());
    });

    // Enter (or the button) must still work, and must not wait out the
    // debounce — cancel any pending run and search immediately.
    $("search-form").addEventListener("submit", (event) => {
      event.preventDefault();
      debouncedSearch.cancel();
      const query = $("q").value.trim();
      syncUrl(query);
      search(query);
    });

    const initial = new URL(location.href).searchParams.get("q") || "";
    $("q").value = initial;
    search(initial.trim());
  </script>
</AdminLayout>
