---
/**
 * /admin/paciente?id=PATIENT_ID — one patient, every folio they have.
 *
 * "+ Nuevo folio" is Flow C: a new folio for a patient the system already
 * knows, asking only for a folio and a PDF (see /admin/nuevo's
 * `?patient=` branch).
 *
 * "Editar datos" opens an inline panel (not a new route) for name / phone /
 * birth date. Phone and birth date are two of the three public-lookup
 * authentication factors (services/public-result-service.ts), so changing
 * either goes through ConfirmSheet naming that consequence before the
 * PATCH is sent; a name-only edit saves directly.
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
import ConfirmSheet from "../../components/admin/ConfirmSheet.astro";
import Icon from "../../components/Icon.astro";
---

<AdminLayout title="Paciente">
  <nav class="crumb" aria-label="Ubicación">
    <a href="/admin">Inicio</a>
    <Icon name="chevron" size={14} />
    <b id="crumb-name">Paciente</b>
  </nav>

  <section class="card" id="patient" hidden aria-labelledby="patient-name">
    <span class="pavatar" id="patient-initials" aria-hidden="true"></span>
    <div class="card__body" style="min-width: 0;">
      <h1 class="card__title clamp-2" id="patient-name"></h1>
      <p class="card__meta" id="patient-meta"></p>
    </div>
    <button class="btn btn--secondary btn--sm" id="edit-open" type="button">Editar datos</button>
  </section>

  <form class="form-card" id="edit-panel" hidden aria-labelledby="edit-h">
    <h2 class="sect" id="edit-h">Editar datos</h2>

    <div class="field">
      <label for="edit-fullName">Nombre completo</label>
      <input id="edit-fullName" name="fullName" type="text" autocomplete="off" />
      <p class="err" id="edit-fullName-err"></p>
    </div>

    <div class="field">
      <label for="edit-phoneNumber">Teléfono</label>
      <input id="edit-phoneNumber" name="phoneNumber" type="tel" placeholder="9990000000" autocomplete="off" />
      <p class="err" id="edit-phoneNumber-err"></p>
    </div>

    <div class="field">
      <label for="edit-birthDate">Fecha de nacimiento</label>
      <input id="edit-birthDate" name="birthDate" type="date" />
      <p class="err" id="edit-birthDate-err"></p>
    </div>

    <p class="status" id="edit-status" role="status" aria-live="polite"></p>

    <div class="actions">
      <button class="btn btn--ghost" id="edit-cancel" type="button">Cancelar</button>
      <button class="btn btn--primary" id="edit-save" type="submit">Guardar cambios</button>
    </div>
  </form>

  <ConfirmSheet
    id="edit-confirm"
    title="Esto cambia quién puede descargar resultados"
    confirmLabel="Guardar de todos modos"
  />

  <div class="row row--between" id="folios-head" hidden>
    <h2 class="sect">Folios</h2>
    <a class="btn btn--secondary btn--sm" id="new-folio" href="/admin/nuevo">
      + Nuevo folio
    </a>
  </div>

  <ul class="results" id="folios-list"></ul>

  <div class="row row--between" id="folios-more" hidden>
    <p class="tiny" id="folios-more-count"></p>
    <button class="btn btn--ghost btn--sm" id="folios-more-btn" type="button">Mostrar todos</button>
  </div>

  <div class="empty" id="empty" hidden>
    <p class="empty__title" id="empty-title">No encontramos al paciente</p>
    <p class="empty__sub" id="empty-sub">Búscalo de nuevo desde el inicio.</p>
  </div>

  <p class="status" id="status" role="status" aria-live="polite"></p>

  <script>
    import { apiJson, withRef } from "../../scripts/admin/api.js";
    import { fillPatientCard, folioRowNode, setStatusLine } from "../../scripts/admin/render.js";
    import { validateFullName, validatePhoneNumber, validateBirthDate } from "../../scripts/admin/validation.js";
    import { diffPatientChanges, needsConsequenceConfirmation } from "../../scripts/admin/patient-edit.js";

    const $ = (id) => document.getElementById(id);

    let patient = null;
    let dirty = false;

    const showEmpty = (title, sub) => {
      $("patient").hidden = true;
      $("folios-head").hidden = true;
      $("empty-title").textContent = title;
      $("empty-sub").textContent = sub;
      $("empty").hidden = false;
    };

    const clearFieldErrors = () => {
      for (const name of ["fullName", "phoneNumber", "birthDate"]) {
        $(`edit-${name}-err`).textContent = "";
      }
    };

    const fillFormFromPatient = () => {
      $("edit-fullName").value = patient.fullName;
      $("edit-phoneNumber").value = patient.phoneNumber;
      $("edit-birthDate").value = patient.birthDate;
      clearFieldErrors();
      setStatusLine($("edit-status"), "");
      dirty = false;
    };

    const openPanel = () => {
      fillFormFromPatient();
      $("edit-panel").hidden = false;
      $("edit-fullName").focus();
    };

    const closePanel = () => {
      $("edit-panel").hidden = true;
      dirty = false;
    };

    /** Validates the form and returns only the fields that actually changed. */
    const diffChanges = () => {
      const fields = {
        fullName: validateFullName($("edit-fullName").value),
        phoneNumber: validatePhoneNumber($("edit-phoneNumber").value),
        birthDate: validateBirthDate($("edit-birthDate").value),
      };

      clearFieldErrors();
      let hasError = false;

      for (const [name, result] of Object.entries(fields)) {
        if (!result.ok) {
          $(`edit-${name}-err`).textContent = result.error;
          hasError = true;
        }
      }

      if (hasError) return null;

      return diffPatientChanges(patient, {
        fullName: fields.fullName.value,
        phoneNumber: fields.phoneNumber.value,
        birthDate: fields.birthDate.value,
      });
    };

    const applyPatientUpdate = (updated) => {
      patient = { ...patient, ...updated };
      fillPatientCard(
        { avatar: $("patient-initials"), name: $("patient-name"), meta: $("patient-meta") },
        patient,
      );
      $("crumb-name").textContent = patient.fullName;
      document.title = `${patient.fullName} · DúoLab`;
    };

    let saving = false;

    const submitChanges = async (changes) => {
      if (saving) return; // duplicate-submit guard
      saving = true;
      setStatusLine($("edit-status"), "Guardando…");
      $("edit-save").disabled = true;
      $("edit-save").setAttribute("aria-busy", "true");

      const { ok, status, payload } = await apiJson(`/patients/${patient.patientId}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(changes),
      });

      saving = false;
      $("edit-save").disabled = false;
      $("edit-save").removeAttribute("aria-busy");

      if (status === 401 || status === 403) {
        setStatusLine($("edit-status"), "Tu sesión venció. Inicia sesión nuevamente para continuar.", "error");
        return;
      }

      if (!ok) {
        if (payload.fields) {
          for (const [name, message] of Object.entries(payload.fields)) {
            const err = $(`edit-${name}-err`);
            if (err) err.textContent = message;
          }
          setStatusLine($("edit-status"), "Revisa los datos marcados.", "error");
        } else {
          setStatusLine(
            $("edit-status"),
            withRef(payload, "No pudimos guardar los cambios. Revisa tu conexión e inténtalo de nuevo."),
            "error",
          );
        }
        $("edit-status").focus?.();
        return;
      }

      applyPatientUpdate(payload.patient);
      dirty = false;
      closePanel();
      setStatusLine($("status"), "Datos del paciente actualizados.");
    };

    $("edit-open").addEventListener("click", openPanel);
    $("edit-cancel").addEventListener("click", () => {
      if (dirty && !confirm("Hay cambios sin guardar. ¿Descartarlos?")) return;
      closePanel();
    });

    $("edit-panel").addEventListener("input", () => {
      dirty = true;
    });

    $("edit-panel").addEventListener("submit", (event) => {
      event.preventDefault();

      const changes = diffChanges();
      if (!changes) return;

      if (Object.keys(changes).length === 0) {
        closePanel();
        return;
      }

      if (needsConsequenceConfirmation(changes)) {
        $("edit-confirm-body").textContent =
          "Esto cambia quién puede descargar los resultados ya publicados de este paciente.";
        const confirmDialog = $("edit-confirm");
        const onConfirm = () => {
          confirmDialog.close();
          submitChanges(changes);
        };
        $("edit-confirm-confirm").addEventListener("click", onConfirm, { once: true });
        $("edit-confirm-cancel").addEventListener(
          "click",
          () => confirmDialog.close(),
          { once: true },
        );
        confirmDialog.showModal();
        return;
      }

      submitChanges(changes);
    });

    window.addEventListener("beforeunload", (event) => {
      if (!dirty) return;
      event.preventDefault();
      event.returnValue = "";
    });

    const init = async () => {
      const patientId = new URL(location.href).searchParams.get("id");

      if (!patientId) {
        showEmpty("Falta el paciente", "Ábrelo de nuevo desde una búsqueda.");
        return;
      }

      setStatusLine($("status"), "Cargando…");
      const { ok, status, payload } = await apiJson(`/patients/${patientId}`);

      if (status === 404) {
        showEmpty("No encontramos al paciente", "Búscalo de nuevo desde el inicio.");
        setStatusLine($("status"), "");
        return;
      }

      if (!ok) {
        setStatusLine($("status"), withRef(payload, "No se pudo abrir al paciente."), "error");
        return;
      }

      patient = payload.patient;

      $("patient").hidden = false;
      applyPatientUpdate(patient);

      $("new-folio").href = `/admin/nuevo?patient=${encodeURIComponent(patient.patientId)}`;
      $("folios-head").hidden = false;

      renderFolios(patient.folios);
    };

    // The 40-folio hostile-data case (docs/09-ux-completion-plan.md §C3):
    // an unpaginated list of that length is its own kind of broken, even
    // though nothing here is technically an error. Capped at 20 with an
    // explicit count and a "mostrar todos" escape hatch — client-side only,
    // since GET /patients/:id already returns every folio in one response;
    // no new endpoint needed for a list this size.
    const FOLIO_LIST_CAP = 20;
    let foliosExpanded = false;

    function renderFolios(folios) {
      if (folios.length === 0) {
        $("folios-list").replaceChildren();
        $("folios-more").hidden = true;
        setStatusLine($("status"), "Este paciente todavía no tiene folios.");
        return;
      }

      const visible = foliosExpanded ? folios : folios.slice(0, FOLIO_LIST_CAP);
      $("folios-list").replaceChildren(
        ...visible.map((folio) => folioRowNode(folio, { metaText: null })),
      );
      setStatusLine($("status"), "");

      if (folios.length > FOLIO_LIST_CAP && !foliosExpanded) {
        $("folios-more-count").textContent = `Mostrando ${visible.length} de ${folios.length}.`;
        $("folios-more").hidden = false;
      } else {
        $("folios-more").hidden = true;
      }
    }

    $("folios-more-btn").addEventListener("click", () => {
      foliosExpanded = true;
      renderFolios(patient.folios);
    });

    init();
  </script>
</AdminLayout>
