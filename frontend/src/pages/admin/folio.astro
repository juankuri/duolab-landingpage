---
/**
 * /admin/folio?f=A-1024 — folio detail.
 *
 * The central screen of the employee module, and the one that makes the domain
 * model visible: a folio holds one or more RESULTS, and the status belongs to
 * each result, not to the folio. Three results can sit in three different states
 * at once. The folio itself shows only a derived summary.
 *
 * The old single-record view read record.files[0] and showed one status, which
 * was correct only for a folio that happened to have exactly one result. The API
 * has always returned every result with its own status; this screen is what
 * finally reads them.
 *
 * The folio travels in a query parameter rather than the path because the build
 * is static: /admin/folio/[folio] would need getStaticPaths over folios that do
 * not exist yet, which means an SSR adapter — a much larger change than a
 * prettier URL is worth right now.
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
import ConfirmSheet from "../../components/admin/ConfirmSheet.astro";
import Dropzone from "../../components/admin/Dropzone.astro";
import Icon from "../../components/Icon.astro";
---

<AdminLayout title="Folio">
  <nav class="crumb" aria-label="Ubicación">
    <a href="/admin">Inicio</a>
    <Icon name="chevron" size={14} />
    <b id="crumb-folio">Folio</b>
  </nav>

  <!-- Patient stays pinned above the results: every decision on this screen is
       about a person, and having to scroll to check who is the mistake that
       matters most here. -->
  <section class="card" id="patient" hidden aria-labelledby="patient-name">
    <span class="pavatar" id="patient-initials" aria-hidden="true"></span>
    <div class="card__body">
      <h1 class="card__title" id="patient-name"></h1>
      <p class="card__meta" id="patient-meta"></p>
    </div>
    <dl class="card__folio">
      <dt>Folio</dt>
      <dd id="folio-value"></dd>
    </dl>
  </section>

  <div class="row row--between" id="results-head" hidden>
    <h2 class="sect">
      Resultados del folio
      <span class="tally" id="tally"></span>
    </h2>
    <button class="btn btn--secondary btn--sm" id="add-result-open" type="button">
      + Añadir resultado
    </button>
  </div>

  <ul class="results" id="results"></ul>

  <p class="tiny" id="model-note" hidden>
    Cada resultado tiene su propio estado y avanza por separado. El folio sólo
    resume.
  </p>

  <div class="empty" id="empty" hidden>
    <p class="empty__title" id="empty-title">Busca un folio</p>
    <p class="empty__sub" id="empty-sub">
      Escribe el folio en la barra de arriba para abrirlo.
    </p>
  </div>

  <p class="status" id="status" role="status" aria-live="polite"></p>

  <!-- A new result never touches the ones already on this folio — the copy
       says so explicitly, because "añadir" reads ambiguously close to
       "reemplazar" otherwise. -->
  <dialog class="sheet" id="add-sheet" aria-labelledby="add-sheet-h">
    <h2 class="sheet__h" id="add-sheet-h">Añadir resultado</h2>
    <p class="sheet__body">
      Se crea un resultado <strong>nuevo</strong> · no reemplaza los
      existentes.
    </p>
    <Dropzone id="add-sheet-file" />
    <progress class="progress" id="add-sheet-progress" hidden max="100" value="0"
    ></progress>
    <p class="status" id="add-sheet-status" role="status" aria-live="polite"></p>
    <div class="actions">
      <button class="btn btn--ghost" id="add-sheet-cancel" type="button">
        Cancelar
      </button>
      <button class="btn" id="add-sheet-submit" type="button" disabled>
        Subir y revisar
      </button>
    </div>
  </dialog>

  <ConfirmSheet
    id="replace-sheet"
    title="Reemplazar archivo"
    confirmLabel="Reemplazar"
    showFile={true}
  />
  <ConfirmSheet id="revoke-sheet" title="Revocar resultado" confirmLabel="Revocar" />

  <script>
    import { API_BASE, apiForm, apiJson, withRef } from "../../scripts/admin/api.js";
    import { actionsFor } from "../../scripts/admin/status.js";
    import { fillWho, loadActor } from "../../scripts/admin/session.js";
    import { uploadResult } from "../../scripts/admin/upload.js";
    import { attachDropzone } from "../../scripts/shared/dropzone.js";
    import {
      fillPatientCard,
      formatMoment,
      formatSize,
      resultName,
      setStatusLine,
      statusBadge,
      tallyNode,
      tallyOf,
    } from "../../scripts/admin/render.js";

    const $ = (id) => document.getElementById(id);

    /** The folio currently open, and the payload it was rendered from. */
    let current = null;
    let actorRole = "EMPLOYEE";

    const setStatus = (message, tone) => setStatusLine($("status"), message, tone);

    const showEmpty = (title, sub) => {
      $("patient").hidden = true;
      $("results-head").hidden = true;
      $("model-note").hidden = true;
      $("results").replaceChildren();
      $("empty-title").textContent = title;
      $("empty-sub").textContent = sub;
      $("empty").hidden = false;
    };

    /* ---------- per-result actions ---------- */

    /**
     * Every mutating action funnels through here so the row cannot be clicked
     * twice, the failure message is built the same way each time, and the screen
     * always re-reads the folio afterwards rather than patching its own idea of
     * the state — which is how a list of four results drifts out of sync.
     *
     * Error messages come from withRef (api.js), shared with the manager
     * screens.
     */
    const act = async (button, request, pending, done) => {
      button.disabled = true;
      setStatus(pending);

      try {
        const { ok, payload } = await request();
        if (!ok) throw new Error(withRef(payload, "No se pudo completar la acción."));

        setStatus(done);
        await load(current.folio);
      } catch (error) {
        setStatus(error.message, "error");
        button.disabled = false;
      }
    };

    const post = (path) => () => apiJson(path, { method: "POST" });

    /**
     * Which actions a result offers comes from the status vocabulary; whether the
     * actor may take them is a separate check, deliberately kept visible here
     * rather than folded into that table. Hiding publish from an employee is a UI
     * courtesy — the server refuses it regardless (requireRole("MANAGER")).
     *
     * revoke is NOT gated here — an employee may revoke too (DEC-013 widened
     * from manager-only), same as every other action besides publish itself.
     */
    const permitted = (action) => (action === "publish" ? actorRole === "MANAGER" : true);

    const ACTION_LABELS = {
      preview: "Ver PDF",
      download: "Descargar",
      confirm: "Confirmar resultado",
      withdraw: "Retirar confirmación",
      publish: "Publicar resultado",
      revoke: "Revocar resultado…",
      replace: "Reemplazar archivo…",
    };

    const runAction = (action, result, button) => {
      switch (action) {
        case "preview":
          window.open(`${API_BASE}/files/${result.fileId}`, "_blank", "noopener");
          return;
        case "download":
          // ?download=1 is what actually makes this a download rather than
          // a second "open in a new tab" — before this the two actions were
          // the same inline-disposition URL.
          window.open(`${API_BASE}/files/${result.fileId}?download=1`, "_blank", "noopener");
          return;
        case "confirm":
          // Confirming used to POST immediately from this row. Now it opens
          // the review screen — the same one "+ Añadir resultado" already
          // lands on after an upload — so an employee always looks at the
          // PDF before vouching for it, on every path that reaches CONFIRMED.
          location.href = `/admin/revisar?f=${encodeURIComponent(current.folio)}&r=${result.fileId}`;
          return;
        case "withdraw":
          return act(
            button,
            post(`/files/${result.fileId}/withdraw`),
            "Retirando la confirmación…",
            "Confirmación retirada.",
          );
        case "publish":
          return act(
            button,
            post(`/files/${result.fileId}/publish`),
            "Publicando…",
            "Resultado publicado.",
          );
        case "revoke":
          openRevokeSheet(result, button);
          return undefined;
        case "replace":
          openReplaceSheet(result, button);
          return undefined;
        default:
          return undefined;
      }
    };

    /* ---------- replace / revoke sheets ---------- */

    let revokeTarget = null;

    const openRevokeSheet = (result, triggerButton) => {
      revokeTarget = { result, triggerButton };
      $("revoke-sheet-body").textContent =
        "El resultado será revocado y no aparecerá para el paciente · no se puede deshacer.";
      $("revoke-sheet-status").textContent = "";
      $("revoke-sheet-confirm").disabled = false;
      $("revoke-sheet").showModal();
    };

    // Native <dialog> focus-traps while open but drops focus to <body> on
    // close (Esc, backdrop click, or either button) — returning it to
    // whatever opened the sheet keeps a keyboard/screen-reader user's place.
    $("revoke-sheet").addEventListener("close", () => revokeTarget?.triggerButton?.focus());

    $("revoke-sheet-cancel").addEventListener("click", () => $("revoke-sheet").close());

    $("revoke-sheet-confirm").addEventListener("click", async () => {
      if (!revokeTarget) return;

      $("revoke-sheet-confirm").disabled = true;
      $("revoke-sheet-status").textContent = "Revocando…";

      const { ok, payload } = await apiJson(`/files/${revokeTarget.result.fileId}/revoke`, {
        method: "POST",
      });

      if (!ok) {
        $("revoke-sheet-status").textContent = withRef(payload, "No se pudo revocar.");
        $("revoke-sheet-status").dataset.tone = "error";
        $("revoke-sheet-confirm").disabled = false;
        return;
      }

      $("revoke-sheet").close();
      setStatus("Resultado revocado.");
      await load(current.folio);
    });

    let replaceTarget = null;
    let replaceFile = null;

    const replaceDropzone = attachDropzone({
      zone: $("replace-sheet-file-zone"),
      input: $("replace-sheet-file"),
      textEl: $("replace-sheet-file-text"),
      statusEl: $("replace-sheet-status"),
      onFile: (file) => {
        replaceFile = file;
        $("replace-sheet-confirm").disabled = !file;
      },
    });

    const openReplaceSheet = (result, triggerButton) => {
      replaceTarget = { result, triggerButton };
      replaceFile = null;
      $("replace-sheet-body").textContent =
        "Se ocultará del paciente inmediatamente · vuelve a Borrador · debe ser confirmado y publicado de nuevo · el PDF anterior se elimina permanentemente · NO crea un nuevo resultado.";
      $("replace-sheet-confirm").disabled = true;
      replaceDropzone.reset();
      $("replace-sheet").showModal();
    };

    $("replace-sheet").addEventListener("close", () => replaceTarget?.triggerButton?.focus());

    $("replace-sheet-cancel").addEventListener("click", () => $("replace-sheet").close());

    $("replace-sheet-confirm").addEventListener("click", async () => {
      if (!replaceTarget || !replaceFile || !current) return;

      $("replace-sheet-confirm").disabled = true;
      $("replace-sheet-status").textContent = "Reemplazando…";
      delete $("replace-sheet-status").dataset.tone;

      const form = new FormData();
      form.set("file", replaceFile);
      const replacedFileId = replaceTarget.result.fileId;
      const folio = current.folio;

      const { ok, payload } = await apiForm(
        `/records/${current.recordId}/files/${replacedFileId}/replace`,
        form,
      );

      if (!ok) {
        $("replace-sheet-status").textContent = withRef(payload, "No se pudo reemplazar.");
        $("replace-sheet-status").dataset.tone = "error";
        $("replace-sheet-confirm").disabled = false;
        return;
      }

      // Replace used to close the sheet and refresh the list in place — the
      // same immediate-confirmation shortcut requirement 2 asks to remove.
      // Landing on review, same as a fresh upload, means the employee looks
      // at the new PDF before it can be confirmed, on every path that
      // reaches CONFIRMED, not only the "add a result" one.
      $("replace-sheet").close();
      location.href = `/admin/revisar?f=${encodeURIComponent(folio)}&r=${replacedFileId}`;
    });

    /** One open menu at a time. Esc closes it and returns focus to its toggle. */
    const closeMenus = ({ returnFocus = false } = {}) => {
      for (const list of document.querySelectorAll(".menu__list")) {
        if (list.hidden) continue;

        const toggle = list.previousElementSibling;
        list.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        if (returnFocus) toggle.focus();
      }
    };

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".menu")) closeMenus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (event.target.closest(".menu__list")) closeMenus({ returnFocus: true });
      else closeMenus();
    });

    /**
     * ↑/↓ move focus between menu items and wrap at the ends; Enter/Space
     * activate the focused item (native button behaviour already covers
     * that, this only owns the arrow keys).
     */
    const wireMenuKeyboardNav = (list) => {
      list.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

        event.preventDefault();
        const items = [...list.querySelectorAll("button")];
        const index = items.indexOf(document.activeElement);
        const delta = event.key === "ArrowDown" ? 1 : -1;
        const next = items[(index + delta + items.length) % items.length];
        next?.focus();
      });
    };

    /* ---------- rendering ---------- */

    const resultMenu = (result, actions) => {
      const menu = document.createElement("div");
      menu.className = "menu";

      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "iconbtn";
      toggle.setAttribute("aria-haspopup", "menu");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", `Más acciones para ${result.name}`);
      toggle.textContent = "⋯";

      const list = document.createElement("ul");
      list.className = "menu__list";
      list.hidden = true;
      list.setAttribute("role", "menu");

      for (const action of actions) {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.setAttribute("role", "menuitem");
        button.className =
          action === "revoke" || action === "replace"
            ? "menu__item menu__item--danger"
            : "menu__item";
        button.textContent = ACTION_LABELS[action];
        button.addEventListener("click", () => {
          closeMenus();
          runAction(action, result, button);
        });
        item.append(button);
        list.append(item);
      }

      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = list.hidden;
        closeMenus();
        list.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        if (open) list.querySelector("button")?.focus();
      });

      wireMenuKeyboardNav(list);

      menu.append(toggle, list);
      return menu;
    };

    const resultRow = (result) => {
      const row = document.createElement("li");
      row.className = "frow";
      row.dataset.state = result.status;

      const icon = document.createElement("span");
      icon.className = "pdfic";
      icon.setAttribute("aria-hidden", "true");
      icon.textContent = "PDF";

      const body = document.createElement("div");
      body.className = "frow__body";

      const name = document.createElement("p");
      name.className = "frow__name";
      name.textContent = result.name;

      const meta = document.createElement("p");
      meta.className = "frow__meta";
      meta.textContent = [
        result.originalFilename,
        formatMoment(result.uploadedAt),
        formatSize(result.sizeBytes),
      ]
        .filter(Boolean)
        .join(" · ");

      body.append(name, meta);

      // ACTIONS.UPLOADED lists "delete" (status.js) but no route or label
      // exists for it yet (docs/04-backlog.md's open phantom-delete
      // question) — filtering to labelled actions here means the ⋯ menu
      // never renders a button reading the literal string "undefined"
      // while that question stays open rather than being decided here.
      const actions = actionsFor(result.status).filter(permitted).filter((a) => ACTION_LABELS[a]);
      row.append(icon, body, statusBadge(result.status));

      /*
       * A draft's next step is promoted out of the menu. It is the one action an
       * employee takes over and over, and burying the common case behind ⋯ while
       * the rare ones sit at the same depth is what makes a tool feel slow.
       */
      if (actions.includes("confirm")) {
        const confirm = document.createElement("button");
        confirm.type = "button";
        confirm.className = "btn btn--secondary btn--sm";
        confirm.textContent = "Revisar y confirmar";
        confirm.addEventListener("click", () => runAction("confirm", result, confirm));
        row.append(confirm);
      }

      const rest = actions.filter((action) => action !== "confirm");
      if (rest.length) row.append(resultMenu(result, rest));

      return row;
    };

    const render = (record) => {
      current = record;

      $("empty").hidden = true;
      $("patient").hidden = false;
      $("results-head").hidden = false;

      $("crumb-folio").textContent = `Folio ${record.folio}`;
      $("folio-value").textContent = record.folio;
      fillPatientCard(
        { avatar: $("patient-initials"), name: $("patient-name"), meta: $("patient-meta") },
        record.patient,
      );
      document.title = `Folio ${record.folio} · DúoLab`;

      // Oldest first: #1 is the first result of the folio and stays #1 as the
      // folio grows. The API orders newest first for the old single-result view.
      const results = [...record.files]
        .sort((a, b) => (a.uploadedAt < b.uploadedAt ? -1 : 1))
        .map((file, index) => ({ ...file, name: resultName(record.folio, file, index) }));

      $("tally").replaceChildren(tallyNode(tallyOf(results)));
      $("results").replaceChildren(...results.map(resultRow));
      $("model-note").hidden = results.length === 0;

      if (results.length === 0) {
        setStatus("Este folio todavía no tiene resultados.");
      }
    };

    /* ---------- add a result ---------- */

    const addSheet = $("add-sheet");
    const addSubmit = $("add-sheet-submit");
    const addProgress = $("add-sheet-progress");
    const addStatus = $("add-sheet-status");
    let pendingFile = null;

    const addDropzone = attachDropzone({
      zone: $("add-sheet-file-zone"),
      input: $("add-sheet-file"),
      textEl: $("add-sheet-file-text"),
      statusEl: addStatus,
      onFile: (file) => {
        pendingFile = file;
        addSubmit.disabled = !file;
      },
    });

    const resetAddSheet = () => {
      pendingFile = null;
      addDropzone.reset();
      addSubmit.disabled = true;
      addProgress.hidden = true;
      addProgress.value = 0;
    };

    $("add-result-open").addEventListener("click", () => {
      resetAddSheet();
      addSheet.showModal();
    });

    $("add-sheet-cancel").addEventListener("click", () => addSheet.close());
    addSheet.addEventListener("close", () => $("add-result-open")?.focus());

    addSubmit.addEventListener("click", async () => {
      if (!pendingFile || !current) return;

      addSubmit.disabled = true;
      addProgress.hidden = false;
      addStatus.textContent = "Subiendo…";
      delete addStatus.dataset.tone;

      try {
        const uploaded = await uploadResult(
          current.recordId,
          pendingFile,
          (percent) => (addProgress.value = percent),
        );

        addSheet.close();
        location.href = `/admin/revisar?f=${encodeURIComponent(current.folio)}&r=${uploaded.fileId}`;
      } catch (error) {
        addStatus.textContent = error.message;
        addStatus.dataset.tone = "error";
        addSubmit.disabled = false;
        addProgress.hidden = true;
      }
    });

    /* ---------- loading ---------- */

    // `skipRender` is only for init()'s first load (below): it runs the
    // folio fetch and the actor fetch in parallel (checkpoint F — the folio
    // id is in `location.search` immediately, nothing about it depends on
    // the role), but `permitted()` reads the outer `actorRole` closure
    // variable at render time, so rendering has to wait until that's
    // actually resolved, not just until the folio fetch is. The two
    // post-mutation callers don't pass it — actorRole is already settled
    // by the time either of them runs, so they keep rendering immediately.
    const load = async (folio, { skipRender = false } = {}) => {
      const { ok, status, payload } = await apiJson(
        `/records/by-folio/${encodeURIComponent(folio)}`,
      );

      if (status === 404) {
        showEmpty(
          `No encontramos el folio ${folio}`,
          "Revisa el folio o créalo desde el inicio.",
        );
        setStatus("");
        return null;
      }

      if (!ok) {
        setStatus(withRef(payload, "No se pudo abrir el folio."), "error");
        return null;
      }

      if (skipRender) return payload.record;

      render(payload.record);
      setStatus("");
      return payload.record;
    };

    const init = async () => {
      const folio = new URL(location.href).searchParams.get("f");

      if (!folio) {
        showEmpty("Busca un folio", "Abre un folio desde el inicio o desde una búsqueda.");
        return;
      }
      setStatus("Abriendo el folio…");

      const [{ role }, record] = await Promise.all([
        loadActor(),
        load(folio.trim().toUpperCase(), { skipRender: true }),
      ]);

      // Role decides what is worth offering, never what is allowed. A failed
      // lookup falls back to EMPLOYEE: the server is the gate either way.
      actorRole = role;
      fillWho(actorRole);

      if (record) {
        render(record);
        setStatus("");
      }
    };

    init();
  </script>
</AdminLayout>
