---
/**
 * /admin — home.
 *
 * Replaces the old single-record intake tool (folio field -> open-or-create
 * -> one file preview -> confirm), which modeled a folio as having exactly
 * one result and one status. That model is gone: a folio holds one or more
 * results, each with its own status (see docs/01-domain.md and
 * /admin/folio, Slice 1). This page is the new entry point built on top of
 * it — recent folios with a derived tally, the manager queue, and a way in
 * to search or create.
 *
 * "+ Nuevo paciente y resultado" points at /admin/nuevo (atomic create:
 * patient + folio + first result in one request).
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
---

<AdminLayout title="Inicio">
  <!-- MANAGER is bounced to /admin/manager (its own, mobile-first surface —
       see docs/03-decisions.md DEC-021) before any of this paints. The role
       is only known after an async GET /me, so this content stays hidden
       until then rather than flashing the dense admin at a manager on a
       phone. Cosmetic only: requireRole("MANAGER") on the server is the
       actual gate, not this. -->
  <p class="tiny" id="gate-loading">Cargando…</p>
  <div id="gate-content" hidden>
  <section class="hero">
    <h1 class="hero__h">Buscar un folio o un paciente</h1>
    <form class="row" id="hero-search" role="search">
      <label class="vh" for="hero-q">Buscar folio, nombre o teléfono</label>
      <input
        id="hero-q"
        name="q"
        type="search"
        data-admin-search
        autocomplete="off"
        placeholder="Folio · nombre · teléfono…"
      />
      <button class="btn" type="submit">Buscar</button>
    </form>
    <a class="btn btn--secondary" href="/admin/nuevo">+ Nuevo paciente y resultado</a>
  </section>

  <div class="row row--between">
    <h2 class="sect">Folios recientes</h2>
  </div>
  <ul class="results" id="recent-list"></ul>
  <div class="empty" id="recent-empty" hidden>
    <p class="empty__title">Sin folios todavía</p>
    <p class="empty__sub">Empieza dando de alta un paciente y su primer resultado.</p>
    <a class="btn" href="/admin/nuevo">+ Nuevo paciente y resultado</a>
  </div>
  <p class="status" id="recent-status" role="status" aria-live="polite"></p>

  <div class="row row--between">
    <h2 class="sect">Gestión de publicación</h2>
  </div>
  <p class="tiny">Resultados confirmados, esperando publicación.</p>
  <ul class="results" id="queue-list"></ul>
  <div class="empty" id="queue-empty" hidden>
    <p class="empty__title">Nada esperando publicación</p>
    <p class="empty__sub">Los resultados confirmados por recepción aparecerán aquí.</p>
  </div>
  <p class="status" id="queue-status" role="status" aria-live="polite"></p>
  </div>

  <script>
    import { apiJson, withRef } from "../../scripts/admin/api.js";
    import { folioRowNode, setStatusLine } from "../../scripts/admin/render.js";
    import { fillWho, loadActor, roleRedirect } from "../../scripts/admin/session.js";

    const $ = (id) => document.getElementById(id);

    const loadList = async (path, listId, statusId, emptyId) => {
      const { ok, payload } = await apiJson(path);
      const status = $(statusId);
      const empty = $(emptyId);

      if (!ok) {
        empty.hidden = true;
        setStatusLine(status, withRef(payload, "No se pudo cargar la lista."), "error");
        return;
      }

      setStatusLine(status, "");

      if (payload.records.length === 0) {
        $(listId).replaceChildren();
        empty.hidden = false;
        return;
      }

      empty.hidden = true;
      $(listId).replaceChildren(...payload.records.map((record) => folioRowNode(record)));
    };

    const init = async () => {
      const desktop = new URL(location.href).searchParams.get("desktop") === "1";

      if (desktop) sessionStorage.setItem("duolab-admin-desktop", "1");

      // Un-waterfall (checkpoint F): neither list depends on the actor's
      // role — only whether the gated content is even shown does. Firing
      // both immediately, before awaiting the role, turns "role, then two
      // lists in series" into three requests in parallel. If `roleRedirect`
      // ends up bouncing away, the fetches were wasted but never blocked
      // the page that needed them; if it doesn't, the lists are already
      // most of the way done by the time gate-content unhides.
      loadList("/records?limit=8", "recent-list", "recent-status", "recent-empty");
      loadList(
        "/records?limit=8&status=CONFIRMED",
        "queue-list",
        "queue-status",
        "queue-empty",
      );

      const { role } = await loadActor();
      const target = roleRedirect(role, location.pathname, {
        desktop: desktop || sessionStorage.getItem("duolab-admin-desktop") === "1",
      });

      if (target) {
        location.replace(target);
        return;
      }

      fillWho(role);
      $("gate-loading").hidden = true;
      $("gate-content").hidden = false;

      $("hero-search").addEventListener("submit", (event) => {
        event.preventDefault();
        const query = $("hero-q").value.trim();
        if (!query) return;
        location.href = `/admin/buscar?q=${encodeURIComponent(query)}`;
      });
    };

    init();
  </script>
</AdminLayout>
