---
/**
 * /admin/revisar?f=FOLIO&r=RESULT_ID — review and confirm one result.
 *
 * Reached only from "+ Añadir resultado" on /admin/folio, right after an
 * upload. One screen, one action: look at the PDF, click "Confirmar
 * resultado" once. There is no second dialog asking to confirm the
 * confirmation — that pattern (described in early handoff notes as a
 * `#confirm-ask` modal) turned out on inspection to already be a single
 * click in the legacy /admin page too; this page keeps it that way rather
 * than reading back in a step nothing here ever had.
 *
 * f/r are query params, not path segments, for the same static-build reason
 * as /admin/folio: no SSR adapter, so no getStaticPaths over ids that don't
 * exist yet.
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
---

<AdminLayout title="Revisar resultado">
  <nav class="crumb" aria-label="Ubicación">
    <a href="/admin">Inicio</a>
    <span aria-hidden="true">›</span>
    <a href="/admin/folio" id="crumb-folio">Folio</a>
    <span aria-hidden="true">›</span>
    <b>Revisar</b>
  </nav>

  <section class="card" id="patient" hidden aria-labelledby="patient-name">
    <span class="pavatar" id="patient-initials" aria-hidden="true"></span>
    <div class="card__body">
      <h1 class="card__title" id="patient-name"></h1>
      <p class="card__meta" id="patient-meta"></p>
    </div>
    <dl class="card__folio">
      <dt>Folio</dt>
      <dd id="folio-value"></dd>
    </dl>
  </section>

  <div class="row row--between" id="result-head" hidden>
    <p class="frow__name" id="result-name"></p>
  </div>
  <p class="frow__meta" id="result-meta" hidden></p>

  <div class="pdf-preview" id="preview" hidden>
    <canvas id="preview-canvas"></canvas>
    <p class="vh" id="preview-text" aria-live="polite"></p>
    <p class="status" id="preview-status" role="status" aria-live="polite"></p>
  </div>

  <div class="row" id="preview-actions" hidden>
    <a class="btn btn--ghost btn--sm" id="preview-newtab" href="#" target="_blank" rel="noopener">
      Ver PDF en pestaña nueva
    </a>
    <a class="btn btn--ghost btn--sm" id="preview-download" href="#">Descargar PDF</a>
  </div>

  <div class="actions" id="confirm-actions" hidden>
    <button class="btn" id="confirm-btn" type="button">Confirmar resultado</button>
  </div>

  <div class="empty" id="confirmed" hidden>
    <p class="empty__title">Resultado confirmado</p>
    <p class="empty__sub">Volviendo al folio…</p>
  </div>

  <div class="empty" id="empty" hidden>
    <p class="empty__title" id="empty-title">No encontramos el resultado</p>
    <p class="empty__sub" id="empty-sub">
      Ábrelo de nuevo desde el folio.
    </p>
  </div>

  <p class="status" id="status" role="status" aria-live="polite"></p>

  <script>
    import { API_BASE, apiJson, withRef } from "../../scripts/admin/api.js";
    import {
      fillPatientCard,
      formatMoment,
      formatSize,
      resultName,
      setStatusLine,
    } from "../../scripts/admin/render.js";
    import { createPdfViewer } from "../../scripts/shared/pdf-viewer.js";

    const $ = (id) => document.getElementById(id);
    const setStatus = (message, tone) => setStatusLine($("status"), message, tone);

    const showEmpty = (title, sub) => {
      $("patient").hidden = true;
      $("result-head").hidden = true;
      $("result-meta").hidden = true;
      $("preview").hidden = true;
      $("preview-actions").hidden = true;
      $("confirm-actions").hidden = true;
      $("empty-title").textContent = title;
      $("empty-sub").textContent = sub;
      $("empty").hidden = false;
    };

    const viewer = createPdfViewer({
      canvas: $("preview-canvas"),
      textLayer: $("preview-text"),
    });

    const init = async () => {
      const params = new URL(location.href).searchParams;
      const folio = (params.get("f") || "").trim().toUpperCase();
      const resultId = params.get("r") || "";

      if (!folio || !resultId) {
        showEmpty("Falta el folio o el resultado", "Ábrelo de nuevo desde el folio.");
        return;
      }

      $("crumb-folio").href = `/admin/folio?f=${encodeURIComponent(folio)}`;

      setStatus("Cargando…");
      const { ok, status, payload } = await apiJson(
        `/records/by-folio/${encodeURIComponent(folio)}`,
      );

      if (status === 404 || (ok && !payload.record)) {
        showEmpty(`No encontramos el folio ${folio}`, "Ábrelo de nuevo desde el inicio.");
        setStatus("");
        return;
      }

      if (!ok) {
        setStatus(withRef(payload, "No se pudo abrir el folio."), "error");
        return;
      }

      const record = payload.record;
      const sorted = [...record.files].sort((a, b) =>
        a.uploadedAt < b.uploadedAt ? -1 : 1,
      );
      const index = sorted.findIndex((f) => f.fileId === resultId);
      const result = sorted[index];

      if (!result) {
        showEmpty("No encontramos ese resultado", "Ábrelo de nuevo desde el folio.");
        setStatus("");
        return;
      }

      $("patient").hidden = false;
      fillPatientCard(
        { avatar: $("patient-initials"), name: $("patient-name"), meta: $("patient-meta") },
        record.patient,
      );
      $("folio-value").textContent = record.folio;
      document.title = `Revisar · ${record.folio} · DúoLab`;

      $("result-head").hidden = false;
      $("result-name").textContent = resultName(record.folio, result, index);
      $("result-meta").hidden = false;
      $("result-meta").textContent = [
        result.originalFilename,
        formatMoment(result.uploadedAt),
        formatSize(result.sizeBytes),
      ]
        .filter(Boolean)
        .join(" · ");

      $("preview").hidden = false;
      $("preview-actions").hidden = false;
      // A plain, tokenless URL is fine here — unlike the patient-facing
      // preview (checkpoint D), this route sits behind Cloudflare Access
      // with no download token in play, so a new-tab navigation carries
      // nothing sensitive in it.
      $("preview-newtab").href = `${API_BASE}/files/${result.fileId}`;
      $("preview-download").href = `${API_BASE}/files/${result.fileId}?download=1`;

      $("preview-status").textContent = "Cargando vista previa…";
      try {
        const res = await fetch(`${API_BASE}/files/${result.fileId}`);
        if (!res.ok) throw new Error();
        await viewer.open(await res.arrayBuffer());
        $("preview-status").textContent = "";
      } catch {
        // The manager's pdf.js viewer has never needed this fallback in
        // practice, but this route now shares the same code path, so a
        // failed fetch or an unparseable PDF gets a real message instead of
        // the iframe's silent blank box.
        $("preview-status").textContent =
          "No se pudo mostrar la vista previa. Ábrelo en una pestaña nueva.";
        $("preview-status").dataset.tone = "error";
      }

      if (result.status !== "UPLOADED") {
        setStatus(
          result.status === "CONFIRMED"
            ? "Este resultado ya está confirmado."
            : "Este resultado ya no está pendiente de confirmar.",
        );
        return;
      }

      $("confirm-actions").hidden = false;
      setStatus("");

      $("confirm-btn").addEventListener("click", async () => {
        $("confirm-btn").disabled = true;
        setStatus("Confirmando…");

        const response = await apiJson(`/files/${result.fileId}/confirm`, {
          method: "POST",
        });

        if (!response.ok) {
          setStatus(withRef(response.payload, "No se pudo confirmar."), "error");
          $("confirm-btn").disabled = false;
          return;
        }

        $("confirm-actions").hidden = true;
        $("confirmed").hidden = false;
        setStatus("");

        setTimeout(() => {
          location.href = `/admin/folio?f=${encodeURIComponent(record.folio)}`;
        }, 900);
      });
    };

    init();
  </script>
</AdminLayout>
