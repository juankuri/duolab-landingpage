---
/**
 * /admin/nuevo — create a patient + folio + first result in one submission
 * (Flow A), or — with `?patient=ID` — just a folio + PDF for a patient the
 * system already knows (Flow C, reached from /admin/paciente's
 * "+ Nuevo folio"). Flow C swaps the name/birth date/phone fields for a
 * PatientChip; the folio and PDF fields are identical either way.
 *
 * There is no draft: the form clears on every load. A folio is either
 * created now or it isn't — nothing here is worth persisting half-filled.
 */
import AdminLayout from "../../components/admin/AdminLayout.astro";
import Dropzone from "../../components/admin/Dropzone.astro";
import Icon from "../../components/Icon.astro";
import PatientChip from "../../components/admin/PatientChip.astro";
---

<AdminLayout title="Nuevo paciente">
  <nav class="crumb" aria-label="Ubicación">
    <a href="/admin">Inicio</a>
    <Icon name="chevron" size={14} />
    <b id="crumb-title">Nuevo paciente y resultado</b>
  </nav>

  <PatientChip />

  <p class="tiny" id="required-legend">* campo obligatorio</p>

  <form id="create-form" novalidate>
    <div class="field" id="field-fullName">
      <label for="fullName">Nombre completo *</label>
      <input
        id="fullName"
        name="fullName"
        type="text"
        autocomplete="off"
        placeholder="Nombre y apellidos, como en su identificación"
        required
      />
      <p class="err" id="err-fullName" data-err></p>
    </div>

    <div class="field" id="field-birthDate">
      <label for="birthDate">Fecha de nacimiento *</label>
      <input id="birthDate" name="birthDate" type="date" required />
      <p class="err" id="err-birthDate" data-err></p>
    </div>

    <div class="field" id="field-phoneNumber">
      <label for="phoneNumber">Teléfono *</label>
      <input
        id="phoneNumber"
        name="phoneNumber"
        type="tel"
        inputmode="tel"
        autocomplete="off"
        placeholder="9990000000"
        required
      />
      <p class="err" id="err-phoneNumber" data-err></p>
    </div>

    <div class="field">
      <label for="folio">Folio *</label>
      <input
        id="folio"
        name="folio"
        type="text"
        autocomplete="off"
        placeholder="ABCD-010126-0001"
        required
      />
      <p class="tiny">
        Sugerido a partir del nombre — puedes cambiarlo.
        <button class="linklike" id="folio-use-suggested" type="button" hidden>Usar el sugerido</button>
      </p>
      <p class="err" id="err-folio" data-err></p>
    </div>

    <div class="field">
      <Dropzone id="pdf-file" label="Arrastra el PDF aquí *" required />
      <p class="err" id="err-file" data-err></p>

      <div class="pdf-preview" id="pdf-preview" hidden>
        <object id="pdf-preview-object" type="application/pdf" aria-label="Vista previa del PDF">
          <p class="pdf-preview__fallback">
            Tu navegador no puede mostrar la vista previa aquí.
            <a id="pdf-preview-fallback-link" target="_blank" rel="noopener">Abrir en una pestaña nueva</a>
          </p>
        </object>
        <button class="btn btn--ghost btn--sm" id="pdf-preview-expand" type="button">
          Ampliar vista previa
        </button>
      </div>
    </div>

    <progress class="progress" id="progress" hidden max="100" value="0"></progress>

    <div class="actions">
      <button class="btn" id="submit" type="submit">Crear y revisar resultado</button>
    </div>

    <p class="status" id="status" role="status" aria-live="polite"></p>
  </form>

  <dialog class="sheet sheet--pdf" id="pdf-fullscreen" aria-label="Vista previa del PDF">
    <div class="pdf-fullscreen__bar">
      <button class="btn btn--ghost btn--sm" id="pdf-fullscreen-close" type="button">
        Cerrar
      </button>
    </div>
    <div class="pdf-fullscreen__body">
      <object id="pdf-fullscreen-object" type="application/pdf" aria-label="Vista previa del PDF, ampliada">
        <p class="pdf-preview__fallback">
          Tu navegador no puede mostrar la vista previa aquí.
          <a id="pdf-fullscreen-fallback-link" target="_blank" rel="noopener">Abrir en una pestaña nueva</a>
        </p>
      </object>
    </div>
  </dialog>

  <dialog class="sheet" id="dup-dialog" aria-labelledby="dup-h">
    <h2 class="sheet__h" id="dup-h">Ese folio ya existe</h2>
    <p class="sheet__body" id="dup-body"></p>
    <div class="actions">
      <button class="btn btn--ghost" id="dup-other" type="button">Cambiar folio</button>
      <button class="btn" id="dup-open" type="button">Abrir el folio existente</button>
    </div>
  </dialog>

  <script>
    import { apiJson, withRef } from "../../scripts/admin/api.js";
    import { suggestFolio as suggestFolioLocally } from "../../scripts/admin/folio.js";
    import { initials } from "../../scripts/admin/render.js";
    import { createRecord } from "../../scripts/admin/upload.js";
    import { validateCreation } from "../../scripts/admin/validation.js";
    import { createBlobPreview } from "../../scripts/shared/blob-preview.js";
    import { attachDropzone } from "../../scripts/shared/dropzone.js";

    const $ = (id) => document.getElementById(id);

    // Flow C: a patient already chosen (?patient=ID) means the name/birth
    // date/phone fields are replaced by the chip, and only folio + PDF are
    // validated and submitted.
    const existingPatientId = new URL(location.href).searchParams.get("patient");
    const fields = existingPatientId
      ? ["folio"]
      : ["fullName", "birthDate", "phoneNumber", "folio"];
    let pendingFile = null;
    let folioTouchedByHand = false;
    // The folio the server most recently suggested — used to tell "the
    // employee is still looking at what we offered" from "they typed their
    // own", which decides whether a 409 retries silently once or shows the
    // duplicate dialog immediately.
    let suggestedFolio = null;
    let suggestionRequestToken = 0;

    const setStatus = (message, tone) => {
      const el = $("status");
      el.textContent = message || "";
      if (tone) el.dataset.tone = tone;
      else delete el.dataset.tone;
    };

    const clearFieldErrors = () => {
      for (const name of [...fields, "file"]) {
        const el = $(`err-${name}`);
        if (el) el.textContent = "";
      }
    };

    const applyFieldErrors = (errors) => {
      clearFieldErrors();
      for (const [name, message] of Object.entries(errors || {})) {
        const el = $(`err-${name}`);
        if (el) el.textContent = message;
      }
    };

    /* ---------- folio suggestion: instant local guess, then the server's authoritative one ---------- */

    // The folio suggestion follows the name until the employee edits the
    // folio field by hand — after that, typing more of the name must not
    // clobber a folio they already chose on purpose.
    const applySuggestion = (folio) => {
      suggestedFolio = folio;
      if (!folioTouchedByHand) $("folio").value = folio;
      $("folio-use-suggested").hidden = !folio || $("folio").value === folio;
    };

    /**
     * `domain/folio.ts` is the authority on the daily sequence — only the
     * server knows how many folios already exist today, across every
     * patient. This call fetches that; `suggestFolioLocally` above is only
     * ever a same-tick placeholder while it's in flight, never trusted for
     * the actual number.
     */
    const requestServerSuggestion = async (query) => {
      const token = ++suggestionRequestToken;
      $("folio").setAttribute("aria-busy", "true");

      const { ok, payload } = await apiJson(`/records/folio-suggestion?${query}`);

      // A newer request already landed (the employee kept typing the name) —
      // this response is stale and must not overwrite what they're seeing.
      if (token !== suggestionRequestToken) return;

      $("folio").removeAttribute("aria-busy");

      if (ok) applySuggestion(payload.folio);
      // A failed suggestion isn't fatal — the local guess (below) already
      // filled the field with everything but the sequence, and the folio
      // stays editable regardless.
    };

    let suggestionDebounce = null;

    $("fullName").addEventListener("input", () => {
      if (folioTouchedByHand) return;

      const local = suggestFolioLocally($("fullName").value);
      if (local) $("folio").value = local;

      clearTimeout(suggestionDebounce);
      if (!$("fullName").value.trim()) return;

      suggestionDebounce = setTimeout(() => {
        requestServerSuggestion(`name=${encodeURIComponent($("fullName").value)}`);
      }, 300);
    });

    $("folio").addEventListener("input", () => {
      folioTouchedByHand = $("folio").value !== suggestedFolio;
      $("folio-use-suggested").hidden = !suggestedFolio || $("folio").value === suggestedFolio;
    });

    $("folio-use-suggested").addEventListener("click", () => {
      if (!suggestedFolio) return;
      $("folio").value = suggestedFolio;
      folioTouchedByHand = false;
      $("folio-use-suggested").hidden = true;
      $("folio").focus();
    });

    /* ---------- preview: renders the moment a file is chosen or dropped ---------- */

    const inlinePreview = createBlobPreview($("pdf-preview-object"));
    const fullscreenPreview = createBlobPreview($("pdf-fullscreen-object"));

    const showPreview = (file) => {
      $("pdf-preview").hidden = false;
      $("pdf-preview-fallback-link").href = inlinePreview.show(file);
    };

    attachDropzone({
      zone: $("pdf-file-zone"),
      input: $("pdf-file"),
      textEl: $("pdf-file-text"),
      statusEl: $("err-file"),
      onFile: (file) => {
        pendingFile = file;
        if (file) {
          $("err-file").textContent = "";
          showPreview(file);
        } else {
          $("pdf-preview").hidden = true;
          inlinePreview.clear();
        }
      },
    });

    $("pdf-preview-expand").addEventListener("click", () => {
      if (!pendingFile) return;
      $("pdf-fullscreen-fallback-link").href = fullscreenPreview.show(pendingFile);
      $("pdf-fullscreen").showModal();
    });

    $("pdf-fullscreen-close").addEventListener("click", () => $("pdf-fullscreen").close());
    $("pdf-fullscreen").addEventListener("close", () => fullscreenPreview.clear());

    let lastConflict = null;

    $("dup-other").addEventListener("click", () => {
      $("dup-dialog").close();
      $("folio").focus();
      $("folio").select();
    });

    $("dup-open").addEventListener("click", () => {
      if (lastConflict) {
        location.href = `/admin/folio?f=${encodeURIComponent(lastConflict.folio)}`;
      }
    });

    // Esc/backdrop dismissal skips both button handlers above, so focus
    // would otherwise drop to <body>; the folio field is what needs fixing
    // either way, so that's also the right place to land here.
    $("dup-dialog").addEventListener("close", () => $("folio").focus());

    let submitting = false;

    const submitCreate = (values) =>
      createRecord(
        existingPatientId
          ? { patientId: existingPatientId, folio: values.folio }
          : {
              fullName: values.fullName,
              birthDate: values.birthDate,
              phoneNumber: values.phoneNumber,
              folio: values.folio,
            },
        values.pdf,
        (percent) => ($("progress").value = percent),
      );

    $("create-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return; // duplicate-submit guard: a second click mid-request must not fire twice
      clearFieldErrors();

      const input = {
        fullName: $("fullName").value,
        birthDate: $("birthDate").value,
        phoneNumber: $("phoneNumber").value,
        folio: $("folio").value,
        pdf: pendingFile,
      };

      const { values, errors, ok } = validateCreation(input, [...fields, "pdf"]);

      if (!ok) {
        applyFieldErrors(errors);
        setStatus("Revisa los datos marcados.", "error");
        return;
      }

      submitting = true;
      $("submit").disabled = true;
      $("submit").setAttribute("aria-busy", "true");
      $("progress").hidden = false;
      $("progress").value = 0;
      setStatus("Creando…");

      let response = await submitCreate(values);

      // The folio in the field was our own suggestion, still untouched by
      // hand, and someone else's create raced it into existing first — the
      // employee never chose this exact number on purpose, so the fix is a
      // silent one retry with a fresh suggestion, not the duplicate dialog.
      if (response.status === 409 && !folioTouchedByHand && values.folio === suggestedFolio) {
        setStatus("Ese folio se acaba de usar. Generando el siguiente disponible…");
        const retryQuery = existingPatientId
          ? `patientId=${encodeURIComponent(existingPatientId)}`
          : `name=${encodeURIComponent(values.fullName)}`;
        const { ok: suggestOk, payload: suggestion } = await apiJson(
          `/records/folio-suggestion?${retryQuery}`,
        );

        if (suggestOk) {
          suggestedFolio = suggestion.folio;
          $("folio").value = suggestion.folio;
          response = await submitCreate({ ...values, folio: suggestion.folio });
        }
      }

      submitting = false;
      $("submit").disabled = false;
      $("submit").removeAttribute("aria-busy");

      if (response.status === 409) {
        lastConflict = response.payload.existingRecord;
        $("dup-body").textContent = lastConflict?.folio
          ? `El folio ${lastConflict.folio} ya tiene un registro${
              lastConflict.patientName ? ` a nombre de ${lastConflict.patientName}` : ""
            }. Genera o escribe otro folio para continuar.`
          : "Ese folio ya existe. Genera o escribe otro folio para continuar.";
        $("dup-dialog").showModal();
        $("progress").hidden = true;
        setStatus("");
        return;
      }

      if (response.status === 400 && response.payload.fields) {
        applyFieldErrors(response.payload.fields);
        setStatus("Revisa los datos marcados.", "error");
        $("progress").hidden = true;
        return;
      }

      if (response.status === 401 || response.status === 403) {
        setStatus("Tu sesión venció. Inicia sesión nuevamente para continuar.", "error");
        $("progress").hidden = true;
        return;
      }

      if (!response.ok) {
        setStatus(withRef(response.payload, "No se pudo crear el registro. Inténtalo de nuevo."), "error");
        $("progress").hidden = true;
        return;
      }

      const { folio, fileId } = response.payload;
      location.href = `/admin/revisar?f=${encodeURIComponent(folio)}&r=${fileId}`;
    });

    /* ---------- Flow C: a patient already chosen ---------- */

    const initFlowC = async () => {
      for (const name of ["fullName", "birthDate", "phoneNumber"]) {
        $(`field-${name}`).hidden = true;
      }

      $("crumb-title").textContent = "Nuevo folio";
      document.title = "Nuevo folio · DúoLab";
      setStatus("Cargando datos del paciente…");

      const { ok, status, payload } = await apiJson(`/patients/${existingPatientId}`);

      if (status === 401 || status === 403) {
        setStatus("Tu sesión venció. Inicia sesión nuevamente para continuar.", "error");
        return;
      }

      if (!ok) {
        setStatus(withRef(payload, "No pudimos cargar al paciente. Revisa tu conexión e inténtalo de nuevo."), "error");
        return;
      }

      const patient = payload.patient;
      $("chip-initials").textContent = initials(patient.fullName);
      $("chip-name").textContent = patient.fullName;
      $("chip-phone").textContent = patient.phoneNumber;
      $("chip-change").href = "/admin/buscar";
      $("patient-chip").hidden = false;
      setStatus("");

      // Flow C's folio suggestion: the patient (and their initials) are
      // already known, so this is `?patientId=`, not `?name=` — no need to
      // wait on the removed fullName field, which never fires here.
      requestServerSuggestion(`patientId=${encodeURIComponent(existingPatientId)}`);
    };

    if (existingPatientId) initFlowC();
  </script>
</AdminLayout>
