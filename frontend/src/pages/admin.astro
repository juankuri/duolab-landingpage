---
/**
 * /admin — internal employee surface for Slice 1.
 *
 * Flow: fill the form (folio, patient, PDF) -> submit -> preview -> confirm.
 * The record and the file are created by two separate API calls, but that is an
 * implementation detail: the employee attaches the PDF up front and submits once.
 *
 * Deliberately does NOT use layouts/Layout.astro — that layout is landing-specific
 * (requires seo/business props, emits canonical + Open Graph + MedicalBusiness
 * JSON-LD). An internal tool needs none of it and must not be indexed.
 */
import "../styles/clients/duolab.css";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Carga de resultados · DúoLab</title>
  </head>
  <body>
    <header class="bar">
      <img src="/logo/logo-mark.svg" alt="" width="28" height="28" />
      <div>
        <span class="bar__name">dúolab</span>
        <span class="bar__ctx">Carga de resultados</span>
      </div>
    </header>

    <main class="work">
      <!-- Folio first: one field decides between opening and creating -->
      <section class="pane pane--start" aria-labelledby="start-h">
        <h1 id="start-h" class="pane__h">Empieza por el folio</h1>

        <form id="seek-form" novalidate>
          <div class="field">
            <label for="seek" class="vh">Folio</label>
            <div class="seek">
              <input
                id="seek"
                name="seek"
                type="text"
                autocomplete="off"
                autofocus
                placeholder="Escribe o escanea el folio…"
                aria-describedby="seek-hint seek-err"
              />
              <button class="btn btn--seek" id="seek-btn" type="submit">
                Buscar
              </button>
            </div>
            <p class="hint" id="seek-hint">
              Si existe, lo abrimos. Si no, creas el registro con ese folio.
            </p>
            <p class="err" id="seek-err" data-err></p>
          </div>
        </form>
      </section>

      <!-- Left: everything needed for one submission -->
      <section class="pane pane--form" aria-labelledby="form-h">
        <h2 id="form-h" class="pane__h">Nuevo registro</h2>

        <form id="record-form" novalidate>
          <div class="field">
            <label for="fullName">Nombre completo</label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              required
              autocomplete="off"
              aria-describedby="fullName-err"
            />
            <p class="err" id="fullName-err" data-err></p>
          </div>

          <div class="row">
            <div class="field">
              <label for="birthDate">Fecha de nacimiento</label>
              <input
                id="birthDate"
                name="birthDate"
                type="date"
                required
                aria-describedby="birthDate-err"
              />
              <p class="err" id="birthDate-err" data-err></p>
            </div>

            <div class="field">
              <label for="phoneNumber">Teléfono</label>
              <input
                id="phoneNumber"
                name="phoneNumber"
                type="tel"
                required
                inputmode="tel"
                autocomplete="off"
                aria-describedby="phoneNumber-err"
              />
              <p class="err" id="phoneNumber-err" data-err></p>
            </div>
          </div>

          <div class="field">
            <label for="folio">Folio</label>
            <input
              id="folio"
              name="folio"
              type="text"
              required
              autocomplete="off"
              aria-describedby="folio-err"
            />
            <p class="err" id="folio-err" data-err></p>
          </div>

          <div class="field">
            <label for="pdf">Archivo PDF</label>
            <div class="drop" id="drop">
              <input
                id="pdf"
                name="pdf"
                type="file"
                accept="application/pdf"
                required
                aria-describedby="pdf-hint pdf-err"
              />
              <p class="drop__hint" id="pdf-hint">
                Arrastra el PDF aquí o selecciónalo. Solo se aceptan archivos PDF.
              </p>
              <p class="drop__file" id="pdf-name" hidden></p>
            </div>
            <p class="err" id="pdf-err" data-err></p>
          </div>

          <div class="actions">
            <button class="btn" id="submit" type="submit">
              Registrar y subir
            </button>
            <button class="btn btn--ghost" id="reset" type="button" hidden>
              Nuevo registro
            </button>
          </div>

          <!-- Determinate: driven by real XHR upload bytes, never faked -->
          <div class="prog" id="prog" hidden>
            <progress id="prog-bar" max="100" value="0"></progress>
            <span class="prog__txt" id="prog-txt"></span>
          </div>

          <p class="status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>

      <!-- Right: the filed document, and the one deliberate check on it -->
      <section class="pane pane--file" aria-labelledby="file-h">
        <h2 id="file-h" class="pane__h">Registros recientes</h2>

        <div id="idle">
          <!-- Manager only, filled from GET /records?status=CONFIRMED. Hidden -->
          <!-- for an employee: showing an action that will be refused is worse -->
          <!-- than not showing it, even though the server is the real gate. -->
          <div id="queue" hidden>
            <h3 class="pane__sub">Pendientes de publicar</h3>
            <ul class="recent" id="queue-list"></ul>
            <p class="status" id="queue-status" role="status" aria-live="polite"
            ></p>
          </div>

          <p class="empty__sub" id="idle-hint">
            Busca un folio o crea un registro para revisar su archivo aquí.
          </p>

          <ul class="recent" id="recent"></ul>
          <p class="status" id="recent-status" role="status" aria-live="polite"
          ></p>
        </div>

        <div class="file" id="file" hidden>
          <dl class="meta">
            <div><dt>Folio</dt><dd id="m-folio"></dd></div>
            <div><dt>Paciente</dt><dd id="m-patient"></dd></div>
            <div><dt>Nacimiento</dt><dd id="m-birth"></dd></div>
            <div><dt>Teléfono</dt><dd id="m-phone"></dd></div>
          </dl>

          <div class="file__head">
            <p class="file__name" id="m-file"></p>
            <p class="state" id="m-state"></p>
          </div>

          <iframe class="preview" id="preview" title="Vista previa del PDF"
          ></iframe>

          <p class="confirm__ask" id="confirm-ask">
            Revisa que el PDF corresponda a este paciente. Si te equivocas,
            puedes reemplazar el archivo mientras no esté publicado.
          </p>

          <div class="actions">
            <button class="btn btn--ghost" id="replace" type="button">
              Reemplazar archivo
            </button>
            <button class="btn" id="confirm" type="button">
              Confirmar archivo
            </button>
          </div>

          <!-- Manager only. Publicar is the action that makes a file visible to -->
          <!-- a patient, so it goes through the same confirmation-dialog pattern -->
          <!-- as every other destructive or consequential action on this page. -->
          <div class="actions" id="manager-actions" hidden>
            <button class="btn btn--danger" id="revoke" type="button" hidden>
              Revocar publicación
            </button>
            <button class="btn" id="publish" type="button" hidden>
              Publicar
            </button>
          </div>

          <!-- Opened by the Reemplazar button; the picked file names the -->
          <!-- consequence in the confirm dialog before anything is deleted. -->
          <input id="replace-pdf" type="file" accept="application/pdf" hidden />

          <p class="status" id="file-status" role="status" aria-live="polite"></p>
        </div>
      </section>
    </main>

    <!-- Folio is unique: creating over an existing one is always a fork, never -->
    <!-- a silent failure. Native <dialog> gives focus trapping and Esc free. -->
    <dialog id="dup-dialog" aria-labelledby="dup-h">
      <h2 id="dup-h" class="dlg__h">Ese folio ya tiene un registro</h2>
      <p class="dlg__body" id="dup-body"></p>
      <div class="actions">
        <button class="btn btn--ghost" id="dup-other" type="button">
          Usar otro folio
        </button>
        <button class="btn" id="dup-open" type="button">
          Abrir el registro existente
        </button>
      </div>
    </dialog>

    <!-- Publishing is the moment a file becomes visible to a patient, so it -->
    <!-- always asks first — even a plain publish, not only a supersede. -->
    <dialog id="pub-dialog" aria-labelledby="pub-h">
      <h2 id="pub-h" class="dlg__h">¿Publicar este archivo?</h2>
      <p class="dlg__body" id="pub-body"></p>
      <div class="actions">
        <button class="btn btn--ghost" id="pub-cancel" type="button">
          Cancelar
        </button>
        <button class="btn" id="pub-go" type="button">
          Sí, publicar
        </button>
      </div>
    </dialog>

    <dialog id="rvk-dialog" aria-labelledby="rvk-h">
      <h2 id="rvk-h" class="dlg__h">¿Revocar la publicación?</h2>
      <p class="dlg__body">
        El paciente ya no podrá ver ni descargar este archivo. Esta acción no
        se puede deshacer; si el resultado es correcto, tendrás que
        publicarlo de nuevo.
      </p>
      <div class="field">
        <label for="rvk-reason">Motivo (opcional)</label>
        <input id="rvk-reason" type="text" maxlength="500" autocomplete="off" />
      </div>
      <div class="actions">
        <button class="btn btn--ghost" id="rvk-cancel" type="button">
          Cancelar
        </button>
        <button class="btn btn--danger" id="rvk-go" type="button">
          Sí, revocar
        </button>
      </div>
    </dialog>

    <dialog id="rep-dialog" aria-labelledby="rep-h">
      <h2 id="rep-h" class="dlg__h">¿Reemplazar el archivo?</h2>
      <p class="dlg__body" id="rep-body"></p>
      <p class="dlg__warn">
        Esto elimina el PDF anterior de forma permanente. No hay versiones y no
        se puede deshacer.
      </p>
      <div class="actions">
        <button class="btn btn--ghost" id="rep-cancel" type="button">
          Cancelar
        </button>
        <button class="btn btn--danger" id="rep-go" type="button">
          Sí, reemplazar
        </button>
      </div>
    </dialog>

    <script is:inline>
      // Local Worker. Change when the deployment story is settled.
      const API_BASE = "http://localhost:8787";

      let actorRole = "EMPLOYEE";

      const $ = (id) => document.getElementById(id);
      const form = $("record-form");
      const submitBtn = $("submit");
      const resetBtn = $("reset");
      const fileInput = $("pdf");
      const drop = $("drop");
      const seekForm = $("seek-form");
      const seekInput = $("seek");
      const replaceInput = $("replace-pdf");
      const dupDialog = $("dup-dialog");
      const repDialog = $("rep-dialog");

      // The record currently shown on the right. Replacing a file needs both ids
      // at once, and re-rendering after the swap needs the patient details, which
      // the URL cannot carry.
      const current = { recordId: null, fileId: null, record: null };

      // Folio auto-suggestion state
      let folioTouched = false;
      const SPANISH_PARTICLES = /\b(de|del|la|las|los|y)\b/gi;

      // Extract 4-letter initials from patient full name.
      // "Maria Lopez" → "MALO", "Mario Jimenez Perez" → "MAJP",
      // "Alejandro" → "ALEJ", etc.
      // "Ángel Núñez" must suggest ANNU, not ÁNNÚ: the folio travels in a URL
      // path and the server only accepts A-Z, 0-9 and hyphens. Decomposing to
      // NFD splits the accent into its own combining mark, which is then
      // dropped, leaving the base letter.
      const stripDiacritics = (text) =>
        text.normalize("NFD").replace(/\p{M}/gu, "");

      const initialsFromName = (name) => {
        const cleaned = stripDiacritics(name)
          .trim()
          .replace(SPANISH_PARTICLES, "")
          .split(/\s+/)
          .filter((word) => word.length > 0)
          .map((word) => word.toUpperCase());

        if (cleaned.length === 0) return "";
        if (cleaned.length === 1) {
          return (cleaned[0] + "XXXX").slice(0, 4);
        }
        if (cleaned.length === 2) {
          return (cleaned[0].slice(0, 2) + cleaned[1].slice(0, 2)).slice(0, 4);
        }
        if (cleaned.length === 3) {
          return (
            cleaned[0].slice(0, 2) +
            cleaned[1].slice(0, 1) +
            cleaned[2].slice(0, 1)
          ).slice(0, 4);
        }
        return cleaned
          .slice(0, 4)
          .map((word) => word[0])
          .join("");
      };

      // Format today's date as DDMMYY
      const todayDDMMYY = () => {
        const now = new Date();
        const pad = (n) => String(n).padStart(2, "0");
        return (
          pad(now.getDate()) +
          pad(now.getMonth() + 1) +
          pad(now.getFullYear() % 100)
        );
      };

      // Suggest folio as ${initials}-${DDMMYY}-
      const updateFolioSuggestion = () => {
        if (folioTouched) return;
        const nameInput = $("fullName");
        const folioInput = $("folio");
        const name = nameInput.value;

        if (!name.trim()) {
          folioInput.value = "";
          return;
        }

        const initials = initialsFromName(name);
        const date = todayDDMMYY();
        folioInput.value = `${initials}-${date}-`;

        // Move cursor to the end so employee can type the sequence number
        folioInput.setSelectionRange(
          folioInput.value.length,
          folioInput.value.length
        );
      };

      // A recordId held only in memory is lost on refresh. Keeping it in the URL
      // makes reload survivable without asking the employee to search again.
      const setUrlRecord = (id) => {
        const url = new URL(location.href);
        url.searchParams.set("record", id);
        history.replaceState({}, "", url);
      };

      const setErr = (name, msg) => {
        const el = $(`${name}-err`);
        el.textContent = msg || "";
        const input = $(name);
        if (input) input.setAttribute("aria-invalid", msg ? "true" : "false");
      };

      const clearErrs = () =>
        document.querySelectorAll("[data-err]").forEach((el) => {
          el.textContent = "";
        });

      // The server reports per-field problems as { fields: { folio: "..." } }.
      // Showing them against the field beats one combined sentence the
      // employee has to map back onto the form themselves.
      const applyFieldErrors = (payload) => {
        if (!payload?.fields) return false;

        for (const [name, msg] of Object.entries(payload.fields)) {
          setErr(name, msg);
        }

        const first = document.querySelector('[aria-invalid="true"]');
        if (first) first.focus();

        return true;
      };

      // Failures carry the request id that the server logged. Showing it means
      // a report of "it did not save" comes with the exact line to look up.
      const withRef = (payload, fallback) => {
        const message = payload?.error || fallback;
        return payload?.requestId ? `${message} (Ref: ${payload.requestId})` : message;
      };

      const STATE_LABEL = {
        // CONFIRMED is an internal verification. It is NOT publication: PUBLISHED
        // is a separate state in the schema and is not implemented yet, so the
        // patient cannot see this file.
        UPLOADED: "Subido · pendiente de confirmar",
        CONFIRMED: "Confirmado · verificado internamente",
        PUBLISHED: "Publicado",
        REVOKED: "Revocado",
      };

      // Short forms for the recent list, where the row has no space to explain
      // itself. NO_FILE is not a stored status: the API reports it for records
      // whose PDF is still missing.
      const SHORT_LABEL = {
        NO_FILE: "Sin archivo",
        UPLOADED: "Borrador",
        CONFIRMED: "Confirmado",
        PUBLISHED: "Publicado",
        REVOKED: "Revocado",
      };

      // Which manager action applies to a status, if any. Showing the wrong
      // one is exactly the kind of mistake that must not be possible: an
      // employee never sees these regardless of status.
      const updateManagerActions = (status) => {
        const wrap = $("manager-actions");
        const isManager = actorRole === "MANAGER";

        wrap.hidden = !isManager;
        if (!isManager) return;

        $("publish").hidden = status !== "CONFIRMED";
        $("revoke").hidden = status !== "PUBLISHED";
        $("publish").disabled = false;
        $("revoke").disabled = false;
      };

      const showFile = (record, file) => {
        $("idle").hidden = true;
        $("file").hidden = false;
        $("file-h").textContent = "Archivo";

        $("m-folio").textContent = record.folio;
        $("m-patient").textContent = record.patient.fullName;
        $("m-birth").textContent = record.patient.birthDate;
        $("m-phone").textContent = record.patient.phoneNumber;
        $("m-file").textContent = file.originalFilename;

        const state = $("m-state");
        state.textContent = STATE_LABEL[file.status] || file.status;
        state.dataset.state = file.status;

        $("preview").src = `${API_BASE}/files/${file.fileId}`;

        // Confirming is a one-way check, so it disappears once done. Replacing
        // stays available: a wrong PDF must be fixable after confirmation too.
        const confirmable = file.status === "UPLOADED";
        $("confirm").hidden = !confirmable;
        $("confirm-ask").hidden = !confirmable;
        $("confirm").dataset.fileId = file.fileId;
        $("replace").hidden = false;
        $("publish").dataset.fileId = file.fileId;
        $("revoke").dataset.fileId = file.fileId;
        updateManagerActions(file.status);

        // Both buttons disable themselves while their request is in flight, so
        // re-enable here or the next record inherits the previous one's state.
        $("confirm").disabled = false;
        $("replace").disabled = false;

        current.recordId = record.recordId ?? current.recordId;
        current.fileId = file.fileId;
        current.record = record;

        if (!confirmable) resetBtn.hidden = false;
      };

      const showIdle = () => {
        $("file").hidden = true;
        $("idle").hidden = false;
        $("file-h").textContent = "Registros recientes";
        $("preview").removeAttribute("src");
        current.recordId = null;
        current.fileId = null;
        current.record = null;
      };

      const loadRecent = async () => {
        try {
          const res = await fetch(`${API_BASE}/records?limit=8`);
          if (!res.ok) throw new Error();
          const payload = await res.json();
          renderRecent(payload.records || []);
        } catch {
          $("recent-status").textContent = "No se pudo cargar la lista.";
        }
      };

      // Shared by the recent list and the manager queue: same row shape, same
      // in-page navigation, different data source and empty-state text.
      const renderRecordList = (listEl, records) => {
        listEl.replaceChildren();

        for (const record of records) {
          const item = document.createElement("li");

          // A button, not a link: opening a record is an in-page state change.
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "rec";
          btn.addEventListener("click", () => openRecord(record.recordId));

          const main = document.createElement("span");
          main.className = "rec__main";
          main.textContent = `${record.folio} · ${record.patientName}`;

          const state = document.createElement("span");
          state.className = "rec__state";
          state.dataset.state = record.status;
          state.textContent = SHORT_LABEL[record.status] || record.status;

          btn.append(main, state);
          item.append(btn);
          listEl.append(item);
        }
      };

      const renderRecent = (records) => {
        renderRecordList($("recent"), records);
        $("recent-status").textContent =
          records.length === 0 ? "Aún no hay registros." : "";
      };

      // Manager only. Confirmed files are exactly the ones waiting on a
      // publish decision, so the queue reuses the recent-list endpoint with a
      // status filter rather than being a separate concept on the server.
      const loadQueue = async () => {
        if (actorRole !== "MANAGER") return;

        try {
          const res = await fetch(`${API_BASE}/records?status=CONFIRMED&limit=20`);
          if (!res.ok) throw new Error();
          const payload = await res.json();
          const records = payload.records || [];

          renderRecordList($("queue-list"), records);
          $("queue-status").textContent =
            records.length === 0 ? "No hay archivos pendientes de publicar." : "";
        } catch {
          $("queue-status").textContent = "No se pudo cargar la lista.";
        }
      };

      const refreshLists = () => {
        loadRecent();
        loadQueue();
      };

      const fillForm = (record) => {
        $("folio").value = record.folio;
        $("fullName").value = record.patient.fullName;
        $("birthDate").value = record.patient.birthDate;
        $("phoneNumber").value = record.patient.phoneNumber;
        // The folio came from the server; never overwrite it with a suggestion.
        folioTouched = true;
      };

      // One renderer for every way a record gets opened: the recent list, the
      // folio search, the duplicate-folio fork, and reload from the URL.
      const showRecord = (record) => {
        setUrlRecord(record.recordId);
        clearErrs();
        fillForm(record);

        current.recordId = record.recordId;
        current.record = record;

        const file = record.files?.[0];

        if (!file) {
          // The record exists but its PDF is missing. Submitting now must attach
          // to this record, not create a second one under the same folio.
          showIdle();
          current.recordId = record.recordId;
          current.record = record;
          submitBtn.disabled = false;
          submitBtn.textContent = "Subir archivo";
          resetBtn.hidden = false;
          $("form-status").textContent =
            "Registro encontrado, aún sin archivo. Adjunta el PDF y súbelo.";
          fileInput.focus();
          return;
        }

        showFile(record, file);
        submitBtn.disabled = true;
        submitBtn.textContent = "Registrar y subir";
        $("form-status").textContent = "";
        $("file-status").textContent = "";
      };

      const openRecord = async (recordId) => {
        try {
          const res = await fetch(`${API_BASE}/records/${recordId}`);
          if (!res.ok) throw new Error("No se pudo abrir el registro.");
          const payload = await res.json();
          if (payload?.record) showRecord(payload.record);
        } catch (error) {
          $("recent-status").textContent = error.message;
        }
      };

      const validate = () => {
        clearErrs();
        const data = Object.fromEntries(new FormData(form));
        let ok = true;

        const required = {
          folio: "Captura el folio.",
          fullName: "Captura el nombre completo.",
          birthDate: "Captura la fecha de nacimiento.",
          phoneNumber: "Captura el teléfono.",
        };

        for (const [name, msg] of Object.entries(required)) {
          if (!String(data[name] || "").trim()) {
            setErr(name, msg);
            ok = false;
          }
        }

        // These mirror the server rules so the employee finds out before the
        // round trip. The server stays the authority: this is convenience,
        // not a check anyone is trusting.
        if (ok) {
          if (!/^[A-Za-z0-9-]{3,32}$/.test(String(data.folio).trim())) {
            setErr("folio", "El folio solo admite letras, números y guiones.");
            ok = false;
          }

          const digits = String(data.phoneNumber).replace(/\D/g, "");
          if (digits.length !== 10 && !(digits.length === 12 && digits.startsWith("52"))) {
            setErr("phoneNumber", "El teléfono debe tener 10 dígitos.");
            ok = false;
          }

          const birth = String(data.birthDate).trim();
          const parsed = new Date(`${birth}T00:00:00Z`);
          if (
            Number.isNaN(parsed.getTime()) ||
            parsed.toISOString().slice(0, 10) !== birth
          ) {
            setErr("birthDate", "Revisa la fecha de nacimiento.");
            ok = false;
          } else if (parsed.getTime() > Date.now()) {
            setErr("birthDate", "La fecha no puede estar en el futuro.");
            ok = false;
          }
        }

        const file = fileInput.files[0];
        if (!file) {
          setErr("pdf", "Selecciona el archivo PDF.");
          ok = false;
        } else if (file.type !== "application/pdf") {
          setErr("pdf", "Solo se aceptan archivos PDF.");
          ok = false;
        } else if (file.size > 15 * 1024 * 1024) {
          setErr("pdf", "El archivo supera los 15 MB.");
          ok = false;
        }

        if (!ok) {
          const first = document.querySelector('[aria-invalid="true"]');
          if (first) first.focus();
          else fileInput.focus();
        }

        return ok ? data : null;
      };

      // fetch() cannot report upload progress, so the PDF goes over XHR to drive
      // a bar that reflects real transferred bytes.
      const uploadPdf = (recordId, file) =>
        new Promise((resolve, reject) => {
          const body = new FormData();
          body.append("file", file);

          const xhr = new XMLHttpRequest();
          xhr.open("POST", `${API_BASE}/records/${recordId}/files`);

          xhr.upload.addEventListener("progress", (e) => {
            if (!e.lengthComputable) return;
            const pct = Math.round((e.loaded / e.total) * 100);
            $("prog-bar").value = pct;
            $("prog-txt").textContent = `Subiendo ${pct}%`;
          });

          xhr.addEventListener("load", () => {
            let payload = {};
            try {
              payload = JSON.parse(xhr.responseText);
            } catch {}
            if (xhr.status >= 200 && xhr.status < 300) resolve(payload);
            else reject(new Error(withRef(payload, "No se pudo subir el archivo.")));
          });

          xhr.addEventListener("error", () =>
            reject(new Error("No se pudo conectar con el servidor.")),
          );

          xhr.send(body);
        });

      // Folio-first entry. There are only two outcomes: the folio exists and we
      // open it, or it does not and it becomes the folio of a new record.
      seekForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        setErr("seek", "");

        const folio = seekInput.value.trim();

        if (!folio) {
          setErr("seek", "Captura o escanea un folio.");
          return;
        }

        $("seek-btn").disabled = true;

        try {
          const res = await fetch(
            `${API_BASE}/records/by-folio/${encodeURIComponent(folio)}`,
          );

          if (res.status === 404) {
            resetToNew();
            $("folio").value = folio;
            folioTouched = true;
            $("form-status").textContent =
              "Folio libre. Captura los datos del paciente y adjunta el PDF.";
            $("fullName").focus();
            return;
          }

          if (!res.ok) throw new Error("No se pudo buscar el folio.");

          const payload = await res.json();
          showRecord(payload.record);
          seekInput.value = "";
        } catch (error) {
          setErr("seek", error.message);
        } finally {
          $("seek-btn").disabled = false;
        }
      });

      // E4 fork. The dialog owns the decision; both buttons close it.
      const askDuplicate = (existing) => {
        $("dup-body").textContent = existing.patientName
          ? `El folio ${existing.folio} pertenece a ${existing.patientName}.`
          : `El folio ${existing.folio} ya está en uso.`;

        $("dup-open").hidden = !existing.recordId;
        dupDialog.showModal();

        $("dup-open").onclick = () => {
          dupDialog.close();
          openRecord(existing.recordId);
        };

        $("dup-other").onclick = () => {
          dupDialog.close();
          const folioInput = $("folio");
          folioInput.value = "";
          folioTouched = true;
          setErr("folio", "Ese folio ya existe. Captura uno distinto.");
          folioInput.focus();
        };
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const data = validate();
        if (!data) return;

        const file = fileInput.files[0];

        // The record was opened without a PDF, so attach to it instead of
        // creating a second record under the same folio.
        const attaching = Boolean(current.recordId && !current.fileId);

        submitBtn.disabled = true;
        $("prog").hidden = false;
        $("prog-bar").value = 0;
        $("prog-txt").textContent = attaching
          ? "Subiendo…"
          : "Creando registro…";
        $("form-status").textContent = attaching
          ? "Subiendo archivo…"
          : "Creando registro…";

        try {
          let recordId = current.recordId;
          let folio = String(data.folio).trim();

          if (!attaching) {
            const res = await fetch(`${API_BASE}/records`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                folio,
                fullName: String(data.fullName).trim(),
                birthDate: String(data.birthDate).trim(),
                phoneNumber: String(data.phoneNumber).trim(),
              }),
            });

            const created = await res.json().catch(() => ({}));

            // A taken folio is not an error to report, it is a decision to
            // hand back to the employee.
            if (res.status === 409) {
              $("form-status").textContent = "";
              $("prog").hidden = true;
              submitBtn.disabled = false;
              askDuplicate(created.existingRecord || { folio });
              return;
            }

            // Per-field problems belong next to the field, not in the status
            // line. Anything else falls through to the general message.
            if (res.status === 400 && applyFieldErrors(created)) {
              $("form-status").textContent = "";
              $("prog").hidden = true;
              submitBtn.disabled = false;
              return;
            }

            if (!res.ok) {
              throw new Error(withRef(created, "No se pudo crear el registro."));
            }

            recordId = created.recordId;
            folio = created.folio;
            setUrlRecord(recordId);
          }

          const uploaded = await uploadPdf(recordId, file);

          showFile(
            {
              recordId,
              folio,
              patient: {
                fullName: String(data.fullName).trim(),
                birthDate: String(data.birthDate).trim(),
                phoneNumber: String(data.phoneNumber).trim(),
              },
            },
            {
              fileId: uploaded.fileId,
              originalFilename: file.name,
              status: uploaded.status || "UPLOADED",
            },
          );

          submitBtn.textContent = "Registrar y subir";
          $("form-status").textContent = "Archivo subido. Revísalo y confírmalo.";
          refreshLists();
          $("confirm").focus();
        } catch (error) {
          $("form-status").textContent = error.message;
          submitBtn.disabled = false;
        } finally {
          $("prog").hidden = true;
        }
      });

      $("confirm").addEventListener("click", async (event) => {
        const fileId = event.currentTarget.dataset.fileId;
        const btn = event.currentTarget;

        btn.disabled = true;
        $("file-status").textContent = "Confirmando…";

        try {
          const res = await fetch(`${API_BASE}/files/${fileId}/confirm`, {
            method: "POST",
          });
          const payload = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(withRef(payload, "No se pudo confirmar el archivo."));
          }

          const state = $("m-state");
          state.textContent = STATE_LABEL.CONFIRMED;
          state.dataset.state = "CONFIRMED";
          $("confirm").hidden = true;
          $("confirm-ask").hidden = true;
          updateManagerActions("CONFIRMED");
          $("file-status").textContent = "Archivo confirmado.";
          resetBtn.hidden = false;
          refreshLists();
          resetBtn.focus();
        } catch (error) {
          $("file-status").textContent = error.message;
          btn.disabled = false;
        }
      });

      const pubDialog = $("pub-dialog");
      const rvkDialog = $("rvk-dialog");

      // Holds what a confirmed publish click will do: which file, and (once a
      // conflict has been named) which currently published file it replaces.
      // supersedes stays null until the server has told us there is
      // something to replace — it is never guessed at up front.
      let pubPending = { fileId: null, supersedes: null };

      const doPublish = async () => {
        pubDialog.close();
        $("publish").disabled = true;
        $("file-status").textContent = "Publicando…";

        const query = pubPending.supersedes
          ? `?supersedes=${pubPending.supersedes}`
          : "";

        try {
          const res = await fetch(
            `${API_BASE}/files/${pubPending.fileId}/publish${query}`,
            { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" },
          );
          const payload = await res.json().catch(() => ({}));

          if (res.status === 409 && payload.code === "ALREADY_PUBLISHED") {
            // Named, not silently replaced: the manager sees exactly what
            // publishing now would revoke, and has to say so again.
            pubPending.supersedes = payload.currentFileId;
            $("pub-body").textContent =
              `Este folio ya tiene publicado "${payload.currentFilename}". ` +
              "Publicar este archivo revocará el anterior de inmediato.";
            $("pub-go").textContent = "Sí, reemplazar";
            $("publish").disabled = false;
            pubDialog.showModal();
            return;
          }

          if (!res.ok) {
            throw new Error(withRef(payload, "No se pudo publicar el archivo."));
          }

          const state = $("m-state");
          state.textContent = STATE_LABEL.PUBLISHED;
          state.dataset.state = "PUBLISHED";
          updateManagerActions("PUBLISHED");
          $("file-status").textContent = "Archivo publicado.";
          refreshLists();
          $("revoke").focus();
        } catch (error) {
          $("file-status").textContent = error.message;
          $("publish").disabled = false;
        }
      };

      $("publish").addEventListener("click", (event) => {
        pubPending = { fileId: event.currentTarget.dataset.fileId, supersedes: null };
        $("pub-body").textContent =
          `Se publicará "${$("m-file").textContent}". El paciente podrá verlo y descargarlo.`;
        $("pub-go").textContent = "Sí, publicar";
        pubDialog.showModal();
      });

      $("pub-cancel").addEventListener("click", () => {
        pubDialog.close();
        $("publish").disabled = false;
      });

      $("pub-go").addEventListener("click", doPublish);

      $("revoke").addEventListener("click", () => {
        $("rvk-reason").value = "";
        rvkDialog.showModal();
      });

      $("rvk-cancel").addEventListener("click", () => {
        rvkDialog.close();
      });

      $("rvk-go").addEventListener("click", async () => {
        const fileId = $("revoke").dataset.fileId;
        const reason = $("rvk-reason").value.trim();
        rvkDialog.close();

        $("revoke").disabled = true;
        $("file-status").textContent = "Revocando…";

        try {
          const res = await fetch(`${API_BASE}/files/${fileId}/revoke`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reason ? { reason } : {}),
          });
          const payload = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(withRef(payload, "No se pudo revocar el archivo."));
          }

          const state = $("m-state");
          state.textContent = STATE_LABEL.REVOKED;
          state.dataset.state = "REVOKED";
          updateManagerActions("REVOKED");
          $("file-status").textContent = "Publicación revocada.";
          refreshLists();
        } catch (error) {
          $("file-status").textContent = error.message;
          $("revoke").disabled = false;
        }
      });

      // Replacing is destructive and has no undo, so the employee picks the new
      // PDF first: the dialog can then name both files before anything is lost.
      $("replace").addEventListener("click", () => {
        replaceInput.click();
      });

      replaceInput.addEventListener("change", () => {
        const picked = replaceInput.files[0];
        if (!picked) return;

        if (picked.type !== "application/pdf") {
          $("file-status").textContent = "Solo se aceptan archivos PDF.";
          replaceInput.value = "";
          return;
        }

        // Read the displayed state, not current.record: confirming updates
        // the former in place and leaves the latter as it was when loaded.
        const wasConfirmed = $("m-state").dataset.state === "CONFIRMED";

        $("rep-body").textContent = wasConfirmed
          ? `${picked.name} reemplazará a ${$("m-file").textContent}. Se retirará la confirmación del archivo actual.`
          : `${picked.name} reemplazará a ${$("m-file").textContent}.`;
        repDialog.showModal();
      });

      $("rep-cancel").addEventListener("click", () => {
        repDialog.close();
        replaceInput.value = "";
      });

      $("rep-go").addEventListener("click", async () => {
        repDialog.close();

        const wasConfirmed = $("m-state").dataset.state === "CONFIRMED";
        const picked = replaceInput.files[0];
        const { recordId, fileId, record } = current;
        if (!picked || !recordId || !fileId) return;

        $("replace").disabled = true;
        $("confirm").disabled = true;
        $("file-status").textContent = "Eliminando el archivo anterior…";

        try {
          // Only an unvouched-for file can be deleted, so a confirmed one is
          // withdrawn first. Two calls rather than one, but the alternative is
          // a server that lets a confirmation disappear silently.
          if (wasConfirmed) {
            const undo = await fetch(`${API_BASE}/files/${fileId}/withdraw`, {
              method: "POST",
            });

            if (!undo.ok) {
              const payload = await undo.json().catch(() => ({}));
              throw new Error(
                withRef(payload, "No se pudo retirar la confirmación."),
              );
            }
          }

          const res = await fetch(
            `${API_BASE}/records/${recordId}/files/${fileId}`,
            { method: "DELETE" },
          );

          if (!res.ok) {
            const payload = await res.json().catch(() => ({}));
            throw new Error(
              withRef(payload, "No se pudo eliminar el archivo anterior."),
            );
          }

          // The old PDF is gone; drop the preview before the new one loads so
          // the pane never shows a file that no longer exists.
          $("preview").removeAttribute("src");
          $("prog").hidden = false;
          $("prog-bar").value = 0;
          $("file-status").textContent = "Subiendo el archivo nuevo…";

          const uploaded = await uploadPdf(recordId, picked);

          showFile(record, {
            fileId: uploaded.fileId,
            originalFilename: picked.name,
            status: uploaded.status || "UPLOADED",
          });

          $("file-status").textContent =
            "Archivo reemplazado. Revísalo y confírmalo.";
          refreshLists();
          $("confirm").focus();
        } catch (error) {
          $("file-status").textContent = error.message;
        } finally {
          $("prog").hidden = true;
          $("replace").disabled = false;
          $("confirm").disabled = false;
          replaceInput.value = "";
        }
      });

      const resetToNew = () => {
        form.reset();
        clearErrs();
        $("pdf-name").hidden = true;
        showIdle();
        $("form-status").textContent = "";
        $("file-status").textContent = "";
        submitBtn.disabled = false;
        submitBtn.textContent = "Registrar y subir";
        resetBtn.hidden = true;

        // Re-enable folio auto-suggestion
        folioTouched = false;

        const url = new URL(location.href);
        url.searchParams.delete("record");
        history.replaceState({}, "", url);
      };

      // Filing several results in a row is the common case.
      resetBtn.addEventListener("click", () => {
        resetToNew();
        refreshLists();
        seekInput.focus();
      });

      const showPicked = () => {
        const file = fileInput.files[0];
        const label = $("pdf-name");
        label.hidden = !file;
        if (file) {
          label.textContent = file.name;
          setErr("pdf", "");
        }
      };

      fileInput.addEventListener("change", showPicked);

      // Folio auto-suggestion: live-update on name keystroke until folio is manually edited
      $("fullName").addEventListener("input", updateFolioSuggestion);

      // Lock folio auto-suggestion the moment employee edits folio manually
      $("folio").addEventListener("input", () => {
        folioTouched = true;
      });

      ["dragenter", "dragover"].forEach((type) =>
        drop.addEventListener(type, (event) => {
          event.preventDefault();
          drop.dataset.over = "true";
        }),
      );

      ["dragleave", "drop"].forEach((type) =>
        drop.addEventListener(type, (event) => {
          event.preventDefault();
          delete drop.dataset.over;
        }),
      );

      drop.addEventListener("drop", (event) => {
        const dropped = event.dataTransfer?.files?.[0];
        if (!dropped) return;
        const transfer = new DataTransfer();
        transfer.items.add(dropped);
        fileInput.files = transfer.files;
        showPicked();
      });

      // The role decides whether the manager queue and actions render at all.
      // Every one of those routes checks for itself server side regardless;
      // this only avoids showing an employee a button that will be refused.
      const init = async () => {
        try {
          const res = await fetch(`${API_BASE}/me`);
          if (res.ok) {
            const me = await res.json();
            actorRole = me.role === "MANAGER" ? "MANAGER" : "EMPLOYEE";
          }
        } catch {
          // Network failure: stay EMPLOYEE, the safer default. Manager
          // actions remain reachable directly by URL and are still enforced
          // server side, so nothing is unsafe, only momentarily hidden.
        }

        $("queue").hidden = actorRole !== "MANAGER";
        refreshLists();

        // Rehydrate after a reload.
        const existing = new URL(location.href).searchParams.get("record");
        if (existing) openRecord(existing);
      };

      init();
    </script>

    <style>
      :global(body) {
        margin: 0;
        font-family: var(--font-body);
        color: var(--text-primary);
        background: var(--color-surface-muted);
        line-height: 1.5;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      .bar {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-soft);
      }

      .bar__name {
        display: block;
        font-weight: var(--font-weight-heading);
        color: var(--color-primary);
      }

      .bar__ctx {
        display: block;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .work {
        display: grid;
        grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
        gap: var(--space-md);
        align-items: start;
        padding: var(--space-md);
        max-width: 1100px;
        margin-inline: auto;
      }

      @media (min-width: 1200px) {
        .work {
          padding-inline: var(--space-lg);
        }
      }

      /* Two stacked panes on the left, the file pane alongside them. Explicit
         placement keeps the source order sensible for keyboard and screen
         readers without a wrapper element. */
      .pane--start {
        grid-column: 1;
        grid-row: 1;
      }

      .pane--form {
        grid-column: 1;
        grid-row: 2;
      }

      .pane--file {
        grid-column: 2;
        grid-row: 1 / span 2;
      }

      @media (max-width: 900px) {
        .work {
          grid-template-columns: minmax(0, 1fr);
        }

        .pane--start,
        .pane--form,
        .pane--file {
          grid-column: 1;
          grid-row: auto;
        }
      }

      .pane {
        background: var(--color-surface);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-md);
        padding: var(--space-md);
      }

      .pane__h {
        margin: 0 0 var(--space-sm);
        font-size: var(--font-size-title);
        font-weight: var(--font-weight-title);
      }

      .pane__sub {
        margin: 0 0 var(--space-xs);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-medium);
        color: var(--text-secondary);
      }

      #queue {
        margin-bottom: var(--space-md);
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--color-surface-soft);
      }

      .field {
        margin-bottom: var(--space-sm);
      }

      .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-sm);
      }

      label {
        display: block;
        margin-bottom: 4px;
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-medium);
      }

      input[type="text"],
      input[type="date"],
      input[type="tel"] {
        width: 100%;
        padding: 10px 12px;
        font: inherit;
        color: inherit;
        background: var(--color-surface);
        border: 1px solid #c9c2d4;
        border-radius: var(--radius-sm);
      }

      input:focus-visible,
      button:focus-visible,
      .drop:focus-within {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      input[aria-invalid="true"] {
        border-color: #b3261e;
      }

      .err:empty {
        display: none;
      }

      .err {
        margin: 4px 0 0;
        font-size: var(--font-size-label);
        color: #b3261e;
      }

      .drop {
        padding: var(--space-sm);
        border: 1px dashed #c9c2d4;
        border-radius: var(--radius-sm);
        background: var(--color-surface-muted);
      }

      .drop[data-over] {
        border-color: var(--color-primary);
        background: var(--color-surface-soft);
      }

      .drop__hint,
      .drop__file {
        margin: var(--space-xs) 0 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .drop__file {
        color: var(--text-primary);
