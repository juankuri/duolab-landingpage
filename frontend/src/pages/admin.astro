      .prog {
        margin-top: var(--space-sm);
      }

      progress {
        width: 100%;
        height: 6px;
      }

      .prog__txt,
      .status {
        display: block;
        margin-top: var(--space-xs);
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .status:empty {
        display: none;
      }

      .empty__sub {
        margin: 0 0 var(--space-sm);
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      /* Visually hidden, still announced. */
      .vh {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .seek {
        display: flex;
        gap: var(--space-xs);
      }

      .seek input {
        flex: 1;
        min-width: 0;
      }

      .btn--seek {
        flex: 0 0 auto;
      }

      .hint {
        margin: 4px 0 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .recent {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 6px;
      }

      /* Rows are built with createElement, so they never carry Astro's scope
         attribute and a plain `.rec {}` would compile to a selector that cannot
         match them. Scoping through the static <ul> keeps these styles local to
         this component while still reaching its runtime children. */
      .recent :global(.rec) {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-xs);
        width: 100%;
        padding: 10px 12px;
        font: inherit;
        color: inherit;
        text-align: left;
        background: var(--color-surface);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-sm);
        cursor: pointer;
      }

      .recent :global(.rec:hover) {
        background: var(--color-surface-muted);
      }

      .recent :global(.rec__main) {
        font-weight: var(--font-weight-medium);
      }

      /* Same rule as .state: the word carries the meaning, colour only echoes it. */
      .recent :global(.rec__state) {
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .recent :global(.rec__state[data-state="CONFIRMED"]) {
        color: #1c6b4a;
      }

      .recent :global(.rec__state[data-state="PUBLISHED"]) {
        color: #1c6b4a;
        font-weight: var(--font-weight-medium);
      }

      .recent :global(.rec__state[data-state="REVOKED"]) {
        color: #b3261e;
      }

      dialog {
        max-width: 30rem;
        padding: var(--space-md);
        color: var(--text-primary);
        background: var(--color-surface);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-md);
      }

      dialog::backdrop {
        background: rgb(0 0 0 / 0.4);
      }

      .dlg__h {
        margin: 0 0 var(--space-xs);
        font-size: var(--font-size-title);
        font-weight: var(--font-weight-title);
      }

      .dlg__body,
      .dlg__warn {
        margin: 0 0 var(--space-xs);
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .dlg__warn {
        color: #b3261e;
      }

      .btn--danger {
        color: var(--text-on-primary);
        background: #b3261e;
        border-color: #b3261e;
      }

      .btn--danger:hover:not(:disabled) {
        background: #8f1e18;
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: var(--space-sm);
        margin: 0 0 var(--space-sm);
      }

      dt {
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      dd {
        margin: 2px 0 0;
        font-weight: var(--font-weight-medium);
      }

      .file__head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-xs);
        padding-top: var(--space-sm);
        border-top: 1px solid var(--color-surface-soft);
      }

      .file__name {
        margin: 0;
        font-weight: var(--font-weight-medium);
      }

      /* State as text, not a decorative pill. Color is never the only signal. */
      .state {
        margin: 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      .state[data-state="CONFIRMED"] {
        color: #1c6b4a;
      }

      .state[data-state="PUBLISHED"] {
        color: #1c6b4a;
        font-weight: var(--font-weight-medium);
      }

      .state[data-state="REVOKED"] {
        color: #b3261e;
      }

      .preview {
        width: 100%;
        height: 480px;
        margin-top: var(--space-sm);
        border: 1px solid var(--color-surface-soft);
        border-radius: var(--radius-sm);
        background: var(--color-surface-muted);
      }

      .confirm__ask {
        margin: var(--space-sm) 0 0;
        font-size: var(--font-size-label);
        color: var(--text-secondary);
      }

      @media (prefers-reduced-motion: reduce) {
        .btn {
          transition: none;
        }
      }
    </style>
  </body>
</html>
